# Copy to server/.env for local runs, or to server/.env.production for deploy/setup-api.sh, which
# uploads it to the server as server/.env. Both names are git-ignored.

# Public origin of the site, no trailing slash. OAuth callbacks and MCP token audiences use it.
PUBLIC_URL=https://productengineer.pro

# GitHub OAuth App (github.com/settings/developers > OAuth Apps > New OAuth App)
#   Homepage URL:               https://productengineer.pro
#   Authorization callback URL: https://productengineer.pro/api/auth/github/callback
# The server requests user:email (read-only email access) during sign-in; no scope setting is
# needed in the GitHub OAuth App dashboard.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials > OAuth client ID,
# type "Web application"). Consent screen / Data Access scopes: openid, profile and email.
#   Authorized JavaScript origin: https://productengineer.pro
#   Authorized redirect URI:      https://productengineer.pro/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set in ecosystem.config.cjs for production; override here for local runs if needed.
# PORT=8790
# DB_PATH=./data/productengineer.sqlite

# Local development only: adds a "Dev sign-in" that needs no OAuth app. Refused unless PUBLIC_URL
# is a localhost URL.
# DEV_LOGIN=1
