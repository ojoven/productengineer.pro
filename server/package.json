{
  "name": "productengineer-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Accounts (GitHub and Google sign-in with email), synced skill progress, and the MCP server for productengineer.pro.",
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/main.ts",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/main.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "check": "tsc -p tsconfig.json",
    "backup": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/backup.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
