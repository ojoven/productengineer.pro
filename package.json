{
  "name": "productengineer.pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "layout": "node --experimental-strip-types scripts/layout.ts",
    "lock-ids": "node --experimental-strip-types scripts/lock-ids.ts",
    "links": "node --experimental-strip-types scripts/check-links.ts",
    "test": "vitest run",
    "test:visual": "playwright test",
    "deploy": "bash deploy/deploy.sh",
    "og": "node --experimental-strip-types scripts/og.ts",
    "export:atlas": "node --experimental-strip-types --no-warnings scripts/export-atlas.ts",
    "figures:docs": "node --experimental-strip-types --no-warnings scripts/figures-docs.ts",
    "api": "npm run export:atlas && cd server && npm run dev",
    "test:api": "cd server && npm test"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.3",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "astro": "7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@types/d3-delaunay": "6.0.4",
    "@types/node": "24.19.2",
    "d3-delaunay": "6.0.6",
    "pagefind": "1.6.0",
    "polygon-clipping": "0.15.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
