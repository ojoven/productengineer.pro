# Weekly link check (Mondays 07:00). Add with `crontab -e` on the machine that holds the repo.
# Dead links make the script exit 1, so cron mails the report if MAILTO is set.
0 7 * * 1  cd /var/www/html/productengineer.pro/website && PATH=$HOME/.nvm/versions/node/v24.21.0/bin:$PATH node --experimental-strip-types --no-warnings scripts/check-links.ts
