---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { atlas } from '../../lib/atlas.ts';
import { usersOf } from '../../atlas/model.ts';

const a = atlas();
const tools = a.tools.map((t) => ({ ...t, used: usersOf(a, 'tools', t.id) }));
const PRICING: Record<string, string> = { 'open-source': 'Open source', free: 'Free', freemium: 'Freemium', paid: 'Paid' };
---

<Base title="Tools" description="Tools used across product engineering, each linked to the skills it serves.">
  <div class="wrap">
    <Crumbs items={[{ href: '/atlas/', label: 'Skills Map' }, { label: 'Tools' }]} />
    <header class="page-head">
      <div class="code-big">{tools.length} tools</div>
      <h1 class="title">Tools</h1>
      <p class="lede">
        What product engineers use, each linked to the skills it serves. Widely used first, with an open-source or free option where
        one exists. No affiliate links.
      </p>
    </header>
    {
      tools.length ? (
        <ul class="index big" style="border-top:1px solid var(--ink)">
          {tools.map((t) => (
            <li>
              <div class="row" style="grid-template-columns:120px minmax(0,1fr) auto">
                <span class="code">{PRICING[t.pricing]}</span>
                <a class="name" href={`/tools/${t.id}/`}>{t.name}</a>
                <span class="go" aria-hidden="true">{t.used.length} →</span>
                <span class="sub" style="grid-column:2 / 4">{t.what}</span>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">The tools index fills in as the research pass covers each territory.</p>
      )
    }
  </div>
</Base>
