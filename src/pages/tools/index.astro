---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { atlas } from '../../lib/atlas.ts';
import { usersOf } from '../../atlas/model.ts';

const a = atlas();
const tools = a.tools.map((t) => ({ ...t, used: usersOf(a, 'tools', t.id) }));
const PRICING: Record<string, string> = { 'open-source': 'open source', free: 'free', freemium: 'freemium', paid: 'paid' };
---

<Base title="Tools" description="Tools used across product engineering, each linked to the skills it serves.">
  <div class="wrap">
    <Crumbs items={[{ label: 'Tools' }]} />
    <h1>Tools</h1>
    <p class="lede">
      Tools that product engineers use, each linked to the skills it serves. Widely used options first, with an open-source or free
      option where one exists. No affiliate links.
    </p>
    {
      tools.length ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Tool</th>
                <th>What it does</th>
                <th>Pricing</th>
                <th>Used for</th>
              </tr>
            </thead>
            <tbody>
              {tools.map((t) => (
                <tr>
                  <td><a href={`/tools/${t.id}/`}>{t.name}</a></td>
                  <td>{t.what}</td>
                  <td><span class="tag">{PRICING[t.pricing]}</span></td>
                  <td style="color:var(--text-2)">{t.used.length} {t.used.length === 1 ? 'topic' : 'topics'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-note">The tools index fills in as the research pass covers each territory.</p>
      )
    }
  </div>
</Base>
