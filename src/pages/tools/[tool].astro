---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import SkillRows from '../../components/SkillRows.astro';
import CapabilityRows from '../../components/CapabilityRows.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { atlas } from '../../lib/atlas.ts';
import { usersOf } from '../../atlas/model.ts';
import type { Capability, Skill, Tool } from '../../atlas/model.ts';

export function getStaticPaths() {
  return atlas().tools.map((t) => ({ params: { tool: t.id }, props: { id: t.id } }));
}
const a = atlas();
const t = a.toolsById.get(Astro.props.id) as Tool;
const used = usersOf(a, 'tools', t.id);
const caps = used.filter((n): n is Capability => n.level === 'capability');
const skills = used.filter((n): n is Skill => n.level === 'skill');
const PRICING: Record<string, string> = { 'open-source': 'Open source', free: 'Free', freemium: 'Freemium', paid: 'Paid' };
---

<Base title={t.name} description={`${t.name}: ${t.what}`}>
  <div class="wrap">
    <Crumbs items={[{ href: '/tools/', label: 'Tools' }, { label: t.name }]} />
    <header class="page-head">
      <div class="code-big">Tool · {PRICING[t.pricing]}</div>
      <h1 class="title" style="display:flex;align-items:center;gap:18px"><ToolIcon url={t.url} size={48} />{t.name}</h1>
      <p class="lede">{t.what}</p>
      <div class="btn-row"><a class="btn" href={t.url} data-learning-id={t.id} data-learning-kind="tool" rel="noopener" target="_blank">{new URL(t.url).hostname.replace(/^www\./, '')} ↗</a></div>
    </header>
    <div class="cols">
      <div>
        <div class="section-head"><h2>Skills it serves</h2><span class="label">{skills.length}</span></div>
        {skills.length ? <SkillRows skills={skills} /> : <p class="empty">Listed for whole capabilities only.</p>}
      </div>
      <div>
        <div class="section-head"><h2>Capabilities</h2><span class="label">{caps.length}</span></div>
        {caps.length ? <CapabilityRows capabilities={caps} descriptions={false} /> : <p class="empty">Listed for single skills only.</p>}
      </div>
    </div>
    <p class="label" style="margin-top:28px">Link checked {t.checked}</p>
  </div>
</Base>
