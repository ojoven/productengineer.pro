---
import Base from '../layouts/Base.astro';
import MapFigure from '../components/MapFigure.astro';
import TerritoryRows from '../components/TerritoryRows.astro';
import { atlas } from '../lib/atlas.ts';

const a = atlas();
const land = a.territories.filter((t) => !t.crossCutting);
const cycle = [
  ['Discover', 'Find a real user problem.'],
  ['Decide', 'Choose a valuable opportunity and a proportionate investment.'],
  ['Design', 'Make the value understandable and usable.'],
  ['Build and ship', 'Turn the hypothesis into working software in users’ hands.'],
  ['Measure and learn', 'Find out what actually happened, and why.'],
  ['Own the outcome', 'Improve, maintain, grow or remove what was built.'],
];
const example = '/atlas/?lit=user-interviews,hypotheses,sample-size,funnel-analysis,retention-curves';
---

<Base>
  <section class="wrap hero">
    <div class="label">The Skill Atlas · v1.0</div>
    <h1 class="display">Everything a product engineer does, on one map.</h1>
    <p class="lede">
      A product engineer finds a problem worth solving, builds the solution, ships it, checks whether it worked and keeps it
      useful. Each tile below is one skill that takes. Each has a short description, checked resources and the tools people use.
    </p>
    <div class="btn-row">
      <a class="btn primary" href="/atlas/">Open the atlas</a>
      <a class="btn" href="/me/">Mark what you know</a>
    </div>
    <div class="stats">
      <div><b>{land.length}</b><span class="label">Territories</span></div>
      <div><b>{a.capabilities.length}</b><span class="label">Capabilities</span></div>
      <div><b>{a.skills.length}</b><span class="label">Skills</span></div>
    </div>
  </section>

  <div class="wrap">
    <div class="split">
      <div class="pane">
        <div class="sticky-map">
          <div class="pane-head"><span class="label">Map</span><span class="label">1 tile = 1 skill</span></div>
          <MapFigure width={660} height={560} />
        </div>
      </div>
      <div class="pane">
        <div class="pane-head"><span class="label">Index</span><span class="label">{a.territories.length} groups</span></div>
        <TerritoryRows territories={a.territories} big />
      </div>
    </div>
  </div>

  <section class="wrap section">
    <div class="section-head"><h2>How to use it</h2><span class="label">4 steps</span></div>
    <ol class="steps">
      <li><span class="n">01</span><h3>Find your way</h3><p>Open a territory, then a capability. Every level is a page, a map and a list.</p></li>
      <li><span class="n">02</span><h3>Read a skill</h3><p>What it is, why a product engineer needs it, and a few resources and tools worth the time.</p></li>
      <li><span class="n">03</span><h3>Mark it</h3><p>Click a hexagon to set learning or comfortable, or a whole capability at once. Your map fills in.</p></li>
      <li><span class="n">04</span><h3>Light a map</h3><p>A link can light any set of skills and join them in order, <a href={example}>like this</a>.</p></li>
    </ol>
  </section>

  <section class="wrap section">
    <div class="section-head"><h2>What a product engineer is</h2><span class="label">Definition</span></div>
    <div class="cols">
      <div class="prose">
        <p class="lede" style="margin-bottom:1em">
          A software engineer who also owns the product side of the work: talking to users, deciding what is worth building,
          shipping it in small steps and checking whether it helped.
        </p>
        <p>
          The job is not to be an expert in every discipline on this map. It is deep technical skill, good product judgment, and
          enough range to own the whole cycle and work well with specialists.
        </p>
        <p>
          For an experienced engineer the biggest gains are rarely another framework. They are discovery, prioritization,
          experimentation, user behavior and business judgment. The map makes those gaps visible.
        </p>
      </div>
      <ol class="index compact">
        {
          cycle.map(([n, d], i) => (
            <li>
              <div class="row" style="grid-template-columns:28px minmax(0,1fr)">
                <span class="code">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <strong style="font-family:var(--cond);font-size:19px;font-weight:600">{n}</strong>
                  <br />
                  <span class="muted" style="font-size:14.5px">{d}</span>
                </span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
