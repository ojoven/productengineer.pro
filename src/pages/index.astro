---
import Base from '../layouts/Base.astro';
import MapFigure from '../components/MapFigure.astro';
import TerritoryRows from '../components/TerritoryRows.astro';
import { atlas, path } from '../lib/atlas.ts';
import { fieldwork } from '../lib/editorial.ts';

const a = atlas();
// every skill page, for the random skill button; the script prefers skills not marked yet
const skillPaths = a.skills.map((s) => path(s)).join(' ');
const land = a.territories.filter((t) => !t.crossCutting);
const cycle = [
  ['Discover', 'Find a real user problem.'],
  ['Decide', 'Choose a valuable opportunity and a proportionate investment.'],
  ['Design', 'Make the value understandable and usable.'],
  ['Build and ship', 'Turn the hypothesis into working software in users’ hands.'],
  ['Measure and learn', 'Find out what actually happened, and why.'],
  ['Own the outcome', 'Improve, maintain, grow or remove what was built.'],
];
const example = '/atlas/?lit=user-interviews,hypotheses,sample-size,funnel-analysis,retention-curves';
const fieldworkCount = (await fieldwork()).length;
---

<Base>
  <section class="wrap hero">
    <div class="label">The Skill Atlas · v1.0</div>
    <h1 class="display">Product engineering on one map.<br /> See where you stand.</h1>
    <p class="lede">
      You already do more than write code. This free map shows the {a.skills.length} skills behind talking to users, deciding
      what to build, shipping it and checking that it worked. Mark what you know and see what to learn next. No sign-up needed.
    </p>
    <div class="btn-row">
      <a class="btn primary" href="/atlas/">Open the atlas</a>
      <a class="btn" href="/atlas/" id="random-skill" data-paths={skillPaths}>
        <svg class="die" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8" cy="8" r="1.5" fill="currentColor" stroke="none"></circle><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle><circle cx="16" cy="16" r="1.5" fill="currentColor" stroke="none"></circle></svg>
        Random skill
      </a>
    </div>
    <div class="stats">
      <div><b>{land.length}</b><span class="label">Territories</span></div>
      <div><b>{a.capabilities.length}</b><span class="label">Capabilities</span></div>
      <div><b>{a.skills.length}</b><span class="label">Skills</span></div>
    </div>
  </section>

  <div class="wrap">
    <div class="split">
      <div class="pane">
        <div class="sticky-map">
          <div class="pane-head"><span class="label">Map</span><span class="label">1 tile = 1 skill</span></div>
          <MapFigure width={660} height={560} />
        </div>
      </div>
      <div class="pane">
        <div class="pane-head"><span class="label">Index</span><span class="label">{a.territories.length} groups</span></div>
        <TerritoryRows territories={a.territories} big />
      </div>
    </div>
  </div>

  <section class="wrap section">
    <div class="section-head"><h2>The map and the work</h2><span class="label">2 parts</span></div>
    <div class="site-parts">
      <div>
        <span class="n">01 · Understanding</span>
        <h3>Atlas</h3>
        <p>The skills of the discipline, with resources and tools for each. See the whole field, where you stand and what to learn next.</p>
        <a class="btn small" href="/atlas/">{a.skills.length} skills →</a>
      </div>
      <div>
        <span class="n">02 · In practice</span>
        <h3>Fieldwork</h3>
        <p>Product reviews, maker interviews, experiments and shipped changes. What I looked at, what I tried and what happened, connected to the skills on the map.</p>
        <a class="btn small" href="/fieldwork/">{fieldworkCount} entries →</a>
      </div>
    </div>
    <p class="muted" style="margin-top:16px;max-width:72ch">
      They are connected. Every review and experiment lights the skills it used on the map, and each skill page links to the work
      that used it. Fieldwork is written by <a href="/about/#who-writes-it">Mikel Torres Ugarte</a>.
    </p>
  </section>

  <section class="wrap section">
    <div class="section-head"><h2>How to use it</h2><span class="label">4 steps</span></div>
    <ol class="steps">
      <li><span class="n">01</span><h3>Find your way</h3><p>Open a territory, then a capability. Every level is a page, a map and a list.</p></li>
      <li><span class="n">02</span><h3>Read a skill</h3><p>What it is, why a product engineer needs it, and a few resources and tools worth the time.</p></li>
      <li><span class="n">03</span><h3>Mark it</h3><p>Mark a skill as learning, comfortable or not interested, or set a whole capability at once. Your map fills in.</p></li>
      <li><span class="n">04</span><h3>Find your focus</h3><p>Filter the <a href="/atlas/">atlas</a> by focus and your progress. A link can also connect skills, <a href={example}>like this</a>.</p></li>
    </ol>
  </section>

  <section class="wrap section">
    <div class="section-head"><h2>Product Engineering Skills</h2><span class="label">For agents</span></div>
    <div class="cols">
      <p class="lede">Bring the product side of the work to your coding agent. Ten skills to understand your product, read its evidence, choose what to build next and check whether it worked.</p>
      <div class="btn-row">
        <a class="btn primary" href="/skills/">Explore the agent skills <span aria-hidden="true">→</span></a>
        <a class="btn" href="/skills/#installation">Installation</a>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head"><h2>What a product engineer is</h2><span class="label">Definition</span></div>
    <div class="cols">
      <div class="prose">
        <p class="lede" style="margin-bottom:1em">
          A software engineer who also owns the product side of the work: talking to users, deciding what is worth building,
          shipping it in small steps and checking whether it helped.
        </p>
        <p>
          The job is not to be an expert in every discipline on this map. It is deep technical skill, good product judgment, and
          enough range to own the whole cycle and work well with specialists.
        </p>
        <p>
          For an experienced engineer the biggest gains are rarely another framework. They are discovery, prioritization,
          experimentation, user behavior and business judgment. The map makes those gaps visible.
        </p>
      </div>
      <ol class="index compact">
        {
          cycle.map(([n, d], i) => (
            <li>
              <div class="row" style="grid-template-columns:28px minmax(0,1fr)">
                <span class="code">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <strong style="font-family:var(--cond);font-size:19px;font-weight:600">{n}</strong>
                  <br />
                  <span class="muted" style="font-size:14.5px">{d}</span>
                </span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<script>
  import { load } from '../scripts/progress.ts';
  import { track } from '../scripts/track.ts';

  // A new random skill on every visit and every click. Without JavaScript the button opens the atlas.
  const btn = document.getElementById('random-skill') as HTMLAnchorElement | null;
  if (btn) {
    const paths = (btn.dataset.paths ?? '').split(' ').filter(Boolean);
    const pick = () => {
      const { progress } = load();
      const fresh = paths.filter((p) => !progress[p.split('/').at(-2) ?? '']);
      const pool = fresh.length ? fresh : paths;
      if (pool.length) btn.href = pool[Math.floor(Math.random() * pool.length)];
    };
    pick();
    btn.addEventListener('click', () => {
      pick();
      track('Random skill');
    });
  }
</script>
