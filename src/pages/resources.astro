---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { atlas, path, code } from '../lib/atlas.ts';
import { usersOf } from '../atlas/model.ts';

const a = atlas();
const rows = a.resources
  .map((r) => {
    const used = usersOf(a, 'resources', r.id);
    return { ...r, used, territories: [...new Set(used.map((n) => n.territory))] };
  })
  .sort((x, y) => x.title.localeCompare(y.title));
const types = [...new Set(rows.map((r) => r.type))].sort();
---

<Base title="Resources" description="Every article, video, course and book on the atlas, filterable by type and territory. Each link is checked before it is listed.">
  <div class="wrap">
    <Crumbs items={[{ href: '/atlas/', label: 'Atlas' }, { label: 'Resources' }]} />
    <header class="page-head">
      <div class="code-big" id="res-count">{rows.length} resources</div>
      <h1 class="title">Resources</h1>
      <p class="lede">
        Written or recorded by practitioners, free unless marked paid, in English, and opened and checked before it was saved.
      </p>
    </header>
    {
      rows.length ? (
        <>
          <form class="btn-row" id="res-filter" style="margin-bottom:20px" data-pagefind-ignore>
            <select name="type" class="btn" aria-label="Type">
              <option value="">All types</option>
              {types.map((t) => <option value={t}>{t}</option>)}
            </select>
            <select name="territory" class="btn" aria-label="Territory">
              <option value="">All territories</option>
              {a.territories.map((t) => <option value={t.id}>{code(t.id)} {t.name}</option>)}
            </select>
          </form>
          <ul class="refs" id="res-list">
            {rows.map((r) => (
              <li class="ref" data-type={r.type} data-territories={r.territories.join(' ')}>
                <span class="kind">
                  <b>{r.type}</b>
                  {r.level === 'intro' ? 'Start here' : 'Go deeper'}
                  {r.paid && <span class="paid"> · Paid</span>}
                </span>
                <div>
                  <a class="t" href={r.url} rel="noopener" target="_blank">{r.title} ↗</a>
                  <div class="by">
                    {r.author}
                    {r.year && <> · {r.year}</>}
                    {r.length && <> · {r.length}</>}
                  </div>
                  <p class="why">{r.why}</p>
                  <div class="by" style="margin-top:6px">
                    For{' '}
                    {r.used.map((n, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={path(n)}>{code(n.id)} {n.name}</a>
                      </>
                    ))}
                  </div>
                </div>
              </li>
            ))}
          </ul>
          <div class="empty res-empty" id="res-empty" role="status" hidden>
            <span id="res-empty-msg">No resources match these filters yet.</span>
            <button type="button" class="btn small" id="res-clear">Clear filters</button>
          </div>
        </>
      ) : (
        <p class="empty">Resources are added territory by territory during the research pass.</p>
      )
    }
  </div>
</Base>

<script>
  const form = document.getElementById('res-filter') as HTMLFormElement | null;
  const items = [...document.querySelectorAll<HTMLElement>('#res-list > li')];
  const count = document.getElementById('res-count');
  const empty = document.getElementById('res-empty');
  const emptyMsg = document.getElementById('res-empty-msg');

  function update() {
    if (!form) return;
    const typeSel = form.elements.namedItem('type') as HTMLSelectElement;
    const terrSel = form.elements.namedItem('territory') as HTMLSelectElement;
    const type = typeSel.value;
    const terr = terrSel.value;
    let shown = 0;
    for (const li of items) {
      const ok = (!type || li.dataset.type === type) && (!terr || li.dataset.territories!.split(' ').includes(terr));
      li.hidden = !ok;
      if (ok) shown++;
    }
    if (count) count.textContent = `${shown} ${shown === 1 ? 'resource' : 'resources'}`;
    if (empty) empty.hidden = shown > 0;
    if (emptyMsg && shown === 0) {
      // Option text is "05 Shipping"; drop the code for the sentence.
      const terrName = terrSel.selectedOptions[0]?.text.replace(/^\d+\s+/, '') ?? '';
      emptyMsg.textContent =
        type && terr
          ? `No ${type} resources in ${terrName} yet.`
          : type
            ? `No ${type} resources yet.`
            : `No resources in ${terrName} yet.`;
    }
  }

  form?.addEventListener('change', update);
  document.getElementById('res-clear')?.addEventListener('click', () => {
    form?.reset();
    update();
    (form?.elements.namedItem('type') as HTMLSelectElement | null)?.focus();
  });
</script>
