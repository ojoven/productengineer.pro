---
import Base from '../../../../layouts/Base.astro';
import Crumbs from '../../../../components/Crumbs.astro';
import MapFigure from '../../../../components/MapFigure.astro';
import SkillRows from '../../../../components/SkillRows.astro';
import CapabilityRows from '../../../../components/CapabilityRows.astro';
import BulkStatus from '../../../../components/BulkStatus.astro';
import Refs from '../../../../components/Refs.astro';
import ToolRefs from '../../../../components/ToolRefs.astro';
import { atlas, skill, territory, path, code } from '../../../../lib/atlas.ts';
import { relatedNodes } from '../../../../atlas/model.ts';
import type { Capability } from '../../../../atlas/model.ts';
import { abs } from '../../../../lib/seo.ts';

export function getStaticPaths() {
  return atlas().capabilities.map((c) => ({ params: { territory: c.territory, capability: c.id }, props: { id: c.id } }));
}
const a = atlas();
const c = a.nodes.get(Astro.props.id) as Capability;
const t = territory(c.territory);
const skills = c.skills.map(skill);
const related = relatedNodes(a, c).filter((n) => n.level !== 'skill' || n.capability !== c.id);
const resources = c.resources.map((id) => a.resourcesById.get(id)!);
const tools = c.tools.map((id) => a.toolsById.get(id)!);
const siblings = t.capabilities.filter((id) => id !== c.id).map((id) => a.nodes.get(id) as Capability);
// A capability is a set of terms (its skills) inside its territory's set.
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${abs(path(c))}#set`,
  name: c.name,
  description: c.description,
  url: abs(path(c)),
  isPartOf: { '@type': 'DefinedTermSet', '@id': `${abs(path(t))}#set`, name: t.name, url: abs(path(t)) },
  hasDefinedTerm: skills.map((s) => ({ '@type': 'DefinedTerm', '@id': `${abs(path(s))}#term`, name: s.name, termCode: code(s.id), url: abs(path(s)) })),
};
---

<Base title={c.name} description={`${c.name} (${t.name}): ${c.description}`} image={`/og/${c.id}.jpg`} jsonld={jsonld}>
  <div class="wrap">
    <Crumbs items={[{ href: '/skills-map/', label: 'Skills Map' }, { href: path(t), label: `${code(t.id)} ${t.name}` }, { label: `${code(c.id)} ${c.name}` }]} />
    <header class="page-head">
      <div class="code-big">{code(c.id)} · Capability in {t.name}</div>
      <h1 class="title">{c.name}</h1>
      <p class="lede">{c.description}</p>
    </header>

    <div class="split">
      <div class="pane">
        <div class="sticky-map">
          <div class="pane-head"><span class="label">Map</span><span class="label" data-rollup={c.skills.join(' ')}>{c.skills.length} skills</span></div>
          <MapFigure focus={c.id} width={660} height={560} />
        </div>
      </div>
      <div class="pane">
        <div class="pane-head"><span class="label">{skills.length} skills</span><span class="label">Click a hexagon to set your status</span></div>
        <SkillRows skills={skills} big />
        <BulkStatus ids={c.skills} name={c.name} />
      </div>
    </div>

    <section class="section">
      <div class="cols">
        <div>
          <div class="section-head"><h2>Where to start</h2><span class="label">{resources.length} resources</span></div>
          <Refs resources={resources} />
        </div>
        {
          tools.length > 0 && (
            <div>
              <div class="section-head"><h2>Tools</h2><span class="label">{tools.length} tools</span></div>
              <ToolRefs tools={tools} />
            </div>
          )
        }
      </div>
    </section>

    <section class="section">
      <div class="cols">
        <div>
          <div class="section-head"><h2>Also in {t.name}</h2><span class="label">{code(t.id)}</span></div>
          <CapabilityRows capabilities={siblings} descriptions={false} />
        </div>
        {
          related.length > 0 && (
            <div>
              <div class="section-head"><h2>Related elsewhere</h2><span class="label">{related.length}</span></div>
              <ul class="index compact">
                {related.map((n) => (
                  <li>
                    <div class="row" data-id={n.id} style="grid-template-columns:64px minmax(0,1fr) auto">
                      <span class="code">{code(n.id)}</span>
                      <a class="name" href={path(n)}>{n.name}</a>
                      <span class="go" aria-hidden="true">→</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>
  </div>
</Base>
