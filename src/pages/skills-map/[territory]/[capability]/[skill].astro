---
import { getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Crumbs from '../../../../components/Crumbs.astro';
import MapFigure from '../../../../components/MapFigure.astro';
import StatusControl from '../../../../components/StatusControl.astro';
import SkillRows from '../../../../components/SkillRows.astro';
import Refs from '../../../../components/Refs.astro';
import ToolRefs from '../../../../components/ToolRefs.astro';
import SkillPractice from '../../../../components/SkillPractice.astro';
import EntryRows from '../../../../components/EntryRows.astro';
import BodyLink from '../../../../components/BodyLink.astro';
import { figures } from '../../../../components/figures/index.ts';
import { itemsForSkill } from '../../../../lib/editorial.ts';
import { atlas, capability, territory, path, code, skill } from '../../../../lib/atlas.ts';
import { relatedNodes } from '../../../../atlas/model.ts';
import type { Skill } from '../../../../atlas/model.ts';
import { abs, ID } from '../../../../lib/seo.ts';

export function getStaticPaths() {
  return atlas().skills.map((s) => ({
    params: { territory: s.territory, capability: s.capability, skill: s.id },
    props: { id: s.id },
  }));
}
const a = atlas();
const s = a.nodes.get(Astro.props.id) as Skill;
const c = capability(s.capability);
const t = territory(s.territory);
const related = relatedNodes(a, s);
const resources = s.resources.map((id) => a.resourcesById.get(id)!);
const tools = s.tools.map((id) => a.toolsById.get(id)!);
const capResources = resources.length ? [] : c.resources.map((id) => a.resourcesById.get(id)!);
// No tools of its own: show the capability's tools instead. No section at all when neither has any.
const capTools = tools.length ? [] : c.tools.map((id) => a.toolsById.get(id)!);
const i = c.skills.indexOf(s.id);
const prev = i > 0 ? skill(c.skills[i - 1]) : undefined;
const next = i < c.skills.length - 1 ? skill(c.skills[i + 1]) : undefined;
const practice = await itemsForSkill(s.id);
// The optional body: src/content/skills/<skill-id>.mdx
const bodyEntry = (await getCollection('skills')).find((e) => e.id === s.id);
const Body = bodyEntry ? (await render(bodyEntry)).Content : undefined;
// A skill is a term in the Skills Map vocabulary; its capability is the set it belongs to.
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  '@id': `${abs(path(s))}#term`,
  name: s.name,
  termCode: code(s.id),
  description: `${s.summary} ${s.description}`,
  url: abs(path(s)),
  inDefinedTermSet: { '@type': 'DefinedTermSet', '@id': `${abs(path(c))}#set`, name: c.name, url: abs(path(c)) },
  subjectOf: { '@type': 'WebPage', url: abs(path(s)), isPartOf: { '@id': ID.website } },
};
---

<Base title={s.name} description={`${s.name}: ${s.summary} ${s.description}`} image={`/og/${c.id}.jpg`} jsonld={jsonld}>
  <div class="wrap">
    <Crumbs
      items={[
        { href: '/skills-map/', label: 'Skills Map' },
        { href: path(t), label: `${code(t.id)} ${t.name}` },
        { href: path(c), label: `${code(c.id)} ${c.name}` },
        { label: `${code(s.id)} ${s.name}` },
      ]}
    />
    <div class="cols" style="margin-top:8px">
      <div>
        <header class="page-head">
          <div class="code-big">{code(s.id)} · Skill in {c.name}</div>
          <h1 class="title">{s.name}</h1>
          <p class="lede">{s.summary}</p>
        </header>
        <div class="prose"><p style="font-size:18px;line-height:1.6;color:var(--ink)">{s.description}</p></div>

        <StatusControl id={s.id} name={s.name} />

        {
          Body && bodyEntry && (
            <section class="section skill-body" id="guide">
              <div class="prose">
                {/* .mdx bodies use figures by name, and links to In practice entries show their faces */}
                <Body components={{ ...figures, a: BodyLink }} />
              </div>
              {
                bodyEntry.data.sources.length > 0 && (
                  <p class="skill-body-sources">
                    Sources:{' '}
                    {bodyEntry.data.sources.map((src, i) => (
                      <>
                        {i > 0 && ' · '}
                        <a href={src.url} rel="noopener" target="_blank">{src.title} ↗</a>
                      </>
                    ))}
                  </p>
                )
              }
            </section>
          )
        }

        <SkillPractice skill={s} />

        {
          practice.length > 0 && (
            <section class="section" id="in-practice">
              <div class="section-head"><h2>In practice</h2><span class="label">Real products</span></div>
              <EntryRows items={practice} compact />
            </section>
          )
        }

        {
          (resources.length > 0 || capResources.length > 0) && (
            <section class="section">
              <div class="section-head"><h2>Resources</h2><span class="label">{resources.length || capResources.length}</span></div>
              {resources.length > 0 && <Refs resources={resources} />}
              {
                capResources.length > 0 && (
                  <>
                    <div class="label" style="margin:0 0 8px">Overview for {c.name}</div>
                    <Refs resources={capResources} />
                  </>
                )
              }
            </section>
          )
        }

        {
          (tools.length > 0 || capTools.length > 0) && (
            <section class="section">
              <div class="section-head"><h2>Tools</h2><span class="label">{tools.length || capTools.length}</span></div>
              {tools.length > 0 && <ToolRefs tools={tools} />}
              {
                capTools.length > 0 && (
                  <>
                    <div class="label" style="margin:0 0 8px">Tools for {c.name}</div>
                    <ToolRefs tools={capTools} />
                  </>
                )
              }
            </section>
          )
        }

        <nav class="btn-row" style="margin-top:32px" aria-label="Skills in this capability" data-pagefind-ignore>
          {prev && <a class="btn" href={path(prev)}>← {prev.name}</a>}
          {next && <a class="btn" href={path(next)}>{next.name} →</a>}
        </nav>
      </div>

      <aside aria-label="Where it sits" style="padding-top:28px">
        <div>
          <div class="pane-head"><span class="label">Where it sits</span><span class="label">{code(c.id)}</span></div>
          <MapFigure focus={s.id} selected={s.id} width={520} height={400} legend={false} />
          <div class="label" style="margin:22px 0 4px">{c.skills.length} skills in {c.name}</div>
          <SkillRows skills={c.skills.map(skill)} compact />
          {
            related.length > 0 && (
              <>
                <div class="label" style="margin:22px 0 4px">Related</div>
                <ul class="index compact">
                  {related.map((n) => (
                    <li>
                      <div class="row" data-id={n.id} style="grid-template-columns:64px minmax(0,1fr) auto">
                        <span class="code">{code(n.id)}</span>
                        <a class="name" href={path(n)}>{n.name}</a>
                        <span class="go" aria-hidden="true">→</span>
                      </div>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .skill-body :global(h2) {
    font-size: clamp(24px, 2.4vw, 30px);
    margin: 28px 0 10px;
  }
  .skill-body :global(h2:first-child) {
    margin-top: 0;
  }
  .skill-body :global(li) {
    color: var(--ink-2);
    margin-bottom: 0.4em;
  }
  .skill-body-sources {
    font: 12px/1.6 var(--mono);
    color: var(--muted);
    margin-top: 20px;
  }
</style>
