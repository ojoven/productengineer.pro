---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
---

<Base title="Search" description="Search every territory, capability, skill, tool and resource." searchable={false}>
  <div class="wrap">
    <Crumbs items={[{ label: 'Search' }]} />
    <header class="page-head">
      <div class="code-big">Search</div>
      <h1 class="title">Find a skill</h1>
      <p class="lede">Looking for an article, video or tool? <a href="/library/">Search the tools & resources library ↗</a></p>
    </header>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search" class="search-box"></div>
    <noscript><p>Search needs JavaScript. The <a href="/skills-map/">Skills Map</a> lists every page without it.</p></noscript>
  </div>
</Base>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (!window.PagefindUI) {
      document.getElementById('search').innerHTML = '<p class="empty">The search index is built with the production build (npm run build).</p>';
      return;
    }
    const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false });
    const q = new URLSearchParams(location.search).get('q');
    if (q) ui.triggerSearch(q);
  });
</script>
