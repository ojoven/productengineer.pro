---
// Phase 0: both map styles on the real taxonomy and the same layout, compared side by side.
import { gzipSync } from 'node:zlib';
import Base from '../layouts/Base.astro';
import { mapSvg, atlas } from '../lib/atlas.ts';
import { themeScope } from '../atlas/map-css.ts';
import type { MapStyle } from '../atlas/map-css.ts';
import type { MapState } from '../atlas/render.ts';

const a = atlas();
const styles: { id: MapStyle; name: string; note: string }[] = [
  { id: 'illustrated', name: 'A. Illustrated', note: 'Coloured terrain, serif labels on pills, purple progress, amber lit route.' },
  { id: 'ink', name: 'B. Blue ink', note: 'One ink colour on paper, handwritten labels, yellow highlighter for progress, pink for lit.' },
];

// A sample state: some skills marked, and a lit route as a shared link would show it.
const measurement = a.capabilities.filter((c) => c.territory === 'measurement').flatMap((c) => c.skills);
const progress: MapState['progress'] = {};
measurement.slice(0, 14).forEach((id, i) => (progress[id] = i % 3 === 0 ? 'learning' : 'comfortable'));
a.capabilities.filter((c) => c.territory === 'engineering').flatMap((c) => c.skills).forEach((id) => (progress[id] = 'comfortable'));
const lit = ['user-interviews', 'hypotheses', 'sample-size', 'funnel-analysis', 'retention-curves'];
const state: MapState = { progress, lit, route: true };

const views = [
  { key: 'world', label: 'World', focus: '', width: 1088, height: 700 },
  { key: 'territory', label: 'Territory: Measurement', focus: 'measurement', width: 1088, height: 640 },
  { key: 'capability', label: 'Capability: Experiment design', focus: 'experiment-design', width: 1088, height: 600, selected: 'sample-size' },
];

function measure(svg: string) {
  return { raw: (svg.length / 1024).toFixed(0), gz: (gzipSync(svg).length / 1024).toFixed(0) };
}

const rendered = styles.map((s) => ({
  ...s,
  views: views.map((v) => {
    const svg = mapSvg({ focus: v.focus, width: v.width, height: v.height, style: s.id, state: { ...state, selected: v.selected ?? null }, idPrefix: `p-${s.id}-${v.key}` });
    return { ...v, svg, size: measure(svg) };
  }),
  thumb: mapSvg({ width: 200, height: 130, style: s.id, scale: 0.42, state: { lit, route: true }, idPrefix: `p-${s.id}-th`, links: false }),
  phone: mapSvg({ focus: 'experiment-design', width: 360, height: 520, style: s.id, scale: 0.82, state, idPrefix: `p-${s.id}-ph` }),
  phoneWorld: mapSvg({ width: 360, height: 520, style: s.id, scale: 0.82, state, idPrefix: `p-${s.id}-pw` }),
  dark: mapSvg({ focus: 'measurement', width: 1088, height: 600, style: s.id, state, idPrefix: `p-${s.id}-dk` }),
}));
const darkCss = themeScope('.force-dark', 'dark') + themeScope('.force-light', 'light');

const criteria: [string, string, string][] = [
  ['Readability, desktop', 'Very legible: serif labels on pills stand out from the colour.', 'Legible; handwritten labels need a halo on busy terrain, which they have.'],
  ['Readability, phone', 'Fine at capability zoom; the world view is small either way, so the list leads.', 'Same. Thin ink lines hold up well at small sizes.'],
  ['200px thumbnail', 'Territories read as colour patches; the lit route is visible.', 'Mostly outline at that size, but the pink route is the strongest element on it.'],
  ['Lit and progress against the art', 'Purple progress and amber route compete with the pastel fills.', 'Clearest: yellow and pink highlighter on one blue ink. Both layers read at once.'],
  ['Sharpness when zoomed', 'This vector stand-in is sharp. The planned raster art would need very large or per-territory close-up art.', 'Fully vector: sharp at every zoom by construction.'],
  ['Cost of a taxonomy change', 'Raster art must be regenerated or retouched when outlines move.', 'Re-run the layout script. Nothing to redraw.'],
  ['Page weight', 'See the sizes under each map. Raster art would add a large image on top.', 'See the sizes under each map. No images at all.'],
  ['Light and dark', 'The vector stand-in themes; real raster art would need a second set for dark mode.', 'Swap paper and ink. Works in both themes for free.'],
];
---

<Base title="Map style prototype" description="Two map styles on the real taxonomy, compared." searchable={false} noindex>
  <style is:inline set:html={darkCss}></style>
  <div class="wrap">
    <div class="kicker" style="margin-top:28px">Phase 0 · not linked from the site</div>
    <h1>Two map styles, one layout</h1>
    <p class="lede">
      Both styles below draw the real taxonomy from the same geometry file: {a.territories.length - 1} territories,
      {a.capabilities.length} capabilities, {a.skills.length} skills. The sample state marks some Measurement skills and all of
      Engineering, and lights five skills joined by a route, as <a href={`/atlas/?lit=${lit.join(',')}`}>a shared link</a> would.
    </p>
    <p class="prose" style="color:var(--text-2)">
      Style A here is a vector stand-in. The plan is to generate its base art with an image model from this layout and trace the
      regions on top; that version would look richer, and also heavier and harder to keep in sync. Everything on this page is
      generated, so the comparison of layout, labels and states is exact.
    </p>

    {
      views.map((v, vi) => (
        <section>
          <h2>{v.label}</h2>
          <div class="proto-grid">
            {rendered.map((s) => (
              <figure class="map-figure">
                <div set:html={s.views[vi].svg} />
                <figcaption>
                  <strong>{s.name}</strong> · {s.views[vi].size.raw} KB SVG, {s.views[vi].size.gz} KB gzipped
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))
    }

    <h2>Thumbnail, 200 px</h2>
    <div class="btn-row" style="gap:24px;align-items:flex-start">
      {
        rendered.map((s) => (
          <figure style="margin:0">
            <div style="width:200px;border:1px solid var(--line);border-radius:8px;overflow:hidden" set:html={s.thumb} />
            <figcaption style="font-size:.85rem;color:var(--text-3);margin-top:4px">{s.name}</figcaption>
          </figure>
        ))
      }
    </div>

    <h2>Phone width</h2>
    <div class="btn-row" style="gap:20px;align-items:flex-start">
      {
        rendered.map((s) => (
          <>
            <figure style="margin:0">
              <div style="width:300px;border:1px solid var(--line);border-radius:14px;overflow:hidden" set:html={s.phoneWorld} />
              <figcaption style="font-size:.85rem;color:var(--text-3);margin-top:4px">{s.name}, world</figcaption>
            </figure>
            <figure style="margin:0">
              <div style="width:300px;border:1px solid var(--line);border-radius:14px;overflow:hidden" set:html={s.phone} />
              <figcaption style="font-size:.85rem;color:var(--text-3);margin-top:4px">{s.name}, capability</figcaption>
            </figure>
          </>
        ))
      }
    </div>

    <h2>Dark theme</h2>
    <div class="proto-grid force-dark">
      {
        rendered.map((s) => (
          <figure class="map-figure" style="background:#0f1730">
            <div set:html={s.dark} />
            <figcaption style="color:#b9c0db">{s.name}</figcaption>
          </figure>
        ))
      }
    </div>

    <h2>Comparison</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Criterion</th><th>A. Illustrated</th><th>B. Blue ink</th></tr></thead>
        <tbody>
          {criteria.map(([c, ia, ib]) => <tr><td><strong>{c}</strong></td><td>{ia}</td><td>{ib}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="prose" style="margin-top:16px">
      <strong>Recommendation: B, blue ink.</strong> It keeps lit and progress states the clearest, costs nothing when the taxonomy
      changes, themes for free and matches the ballpoint posts. The site currently renders B; switching is one setting in
      <code>src/site.ts</code>.
    </p>
  </div>
</Base>

<style>
  .proto-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 900px) {
    .proto-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
