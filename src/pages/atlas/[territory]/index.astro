---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import MapFigure from '../../../components/MapFigure.astro';
import CapabilityRows from '../../../components/CapabilityRows.astro';
import { atlas, capability, skillIds, code } from '../../../lib/atlas.ts';
import type { Territory } from '../../../atlas/model.ts';

export function getStaticPaths() {
  return atlas().territories.map((t) => ({ params: { territory: t.id }, props: { id: t.id } }));
}
const a = atlas();
const t = a.nodes.get(Astro.props.id) as Territory;
const caps = t.capabilities.map(capability);
const ids = skillIds(t);
---

<Base title={t.name} description={`${t.name}: ${t.question} ${t.description}`.slice(0, 300)} image={`/og/${t.id}.jpg`}>
  <div class="wrap">
    <Crumbs items={[{ href: '/atlas/', label: 'Atlas' }, { label: `${code(t.id)} ${t.name}` }]} />
    <header class="page-head">
      <div class="code-big">{code(t.id)} · {t.crossCutting ? 'Cross-cutting' : 'Territory'} · {t.tagline}</div>
      <h1 class="title">{t.name}</h1>
      <p class="question">{t.question}</p>
    </header>

    <div class="split">
      <div class="pane">
        <div class="sticky-map">
          <div class="pane-head"><span class="label">Map</span><span class="label" data-rollup={ids.join(' ')}>{ids.length} skills</span></div>
          <MapFigure focus={t.id} width={660} height={600} />
        </div>
      </div>
      <div class="pane">
        <div class="pane-head"><span class="label">{caps.length} capabilities</span><span class="label">Click a tile to open a skill</span></div>
        <CapabilityRows capabilities={caps} />
      </div>
    </div>

    <section class="section">
      <div class="section-head"><h2>About {t.name}</h2><span class="label">{code(t.id)}</span></div>
      <div class="cols">
        <div class="prose"><p class="lede">{t.description}</p></div>
        <div>
          <div class="label" style="margin-bottom:8px">What a product engineer should be able to do here</div>
          <p style="font-family:var(--cond);font-size:22px;line-height:1.3;font-weight:500">{t.expected}</p>
        </div>
      </div>
    </section>
  </div>
</Base>
