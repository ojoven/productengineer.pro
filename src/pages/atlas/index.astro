---
// The explorer: map and index side by side, at the same size. Without JavaScript it is the
// static world map and the territory index, both linking to every page. With JavaScript it
// zooms between levels, keeps each level in the URL, and accepts ?lit=id,id to light skills
// and join them with a route.
import Base from '../../layouts/Base.astro';
import { FOCUS_OPTIONS, PROGRESS_FILTERS } from '../../atlas/filters.ts';
import TerritoryRows from '../../components/TerritoryRows.astro';
import { atlas, mapSvg } from '../../lib/atlas.ts';

const a = atlas();
const svg = mapSvg({ width: 760, height: 700 });
---

<Base title="Skills Map" description={`Explore product engineering in the Skills Map: ${a.territories.filter((t) => !t.crossCutting).length} territories, ${a.capabilities.length} capabilities and ${a.skills.length} skills. Mark what you know and see what to learn next.`} bodyClass="is-explorer" searchable={false}>
  <div class="explorer" id="explorer">
    <div class="ex-map" id="ex-map" set:html={svg} />
    <aside class="ex-panel" id="ex-panel" aria-live="polite">
      <nav class="crumbs" id="ex-crumbs" aria-label="Map level"><span aria-current="page">Skills Map</span></nav>
      <div class="ex-filters" aria-label="Filter skills">
        <div><label for="ex-focus" class="label">Focus</label><select id="ex-focus" disabled>
          <option value="">All focus areas</option>
          {FOCUS_OPTIONS.map((option) => <option value={option.id}>{option.label}</option>)}
        </select></div>
        <div><label for="ex-progress" class="label">Your progress</label><select id="ex-progress" disabled>
          {PROGRESS_FILTERS.map((option) => <option value={option.id}>{option.label}</option>)}
        </select></div>
        <p id="ex-filter-note" role="status">Focus areas overlap. Combine focus with your progress.</p>
        <button class="btn small" id="ex-reset-filters" type="button" hidden>Clear filters</button>
      </div>
      <noscript><p>Enable JavaScript to filter skills and load your progress. You can still browse every territory below.</p></noscript>
      <div class="ex-head">
        <div class="code-big" id="ex-code">Skills Map · {a.skills.length} skills</div>
        <h1 class="ex-title" id="ex-title">Skills Map</h1>
        <p class="ex-text" id="ex-text">Explore the skills of product engineering, including AI. Pick a territory to see its capabilities and skills.</p>
        <div id="ex-actions"></div>
        <div id="ex-lit"></div>
      </div>
      <div class="pane-head ex-listhead"><span class="label" id="ex-list-title">Territories</span><span class="label" id="ex-list-count"></span></div>
      <div id="ex-list"><TerritoryRows territories={a.territories} /></div>
    </aside>
  </div>
</Base>

<style is:global>
  body.is-explorer .site-footer {
    display: none;
  }
  .explorer {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(380px, 1fr);
    height: calc(100dvh - var(--head));
    min-height: 520px;
  }
  .ex-map {
    position: relative;
    overflow: hidden;
    touch-action: manipulation;
  }
  .ex-map svg {
    width: 100%;
    height: 100%;
  }
  .ex-map .pm text,
  .ex-map .pm .sl-g {
    transition: opacity 0.18s ease;
  }
  .ex-map.is-zooming .pm text,
  .ex-map.is-zooming .pm .route,
  .ex-map.is-zooming .pm .route-halo,
  .ex-map.is-zooming .pm .route-dot {
    opacity: 0 !important;
  }
  .ex-map.is-entering .pm text {
    opacity: 0;
  }
  .ex-panel {
    border-left: 1px solid var(--ink);
    overflow-y: auto;
    padding: 0 var(--gutter) 40px 28px;
  }
  .ex-head {
    padding: 18px 0 22px;
    display: grid;
    gap: 12px;
  }
  .ex-filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 12px; padding: 18px 0 0; }
  .ex-filters label { display: block; margin-bottom: 6px; }
  .ex-filters select { width: 100%; font: 14px var(--ui, var(--sans)); color: var(--ink); background-color: var(--bg); border: 1px solid var(--line); padding: 8px 36px 8px 8px; background-position: right 12px center; }
  .ex-filters p { grid-column: 1 / -1; font-size: 13px; margin: 0; color: var(--muted); }
  .ex-filters button { justify-self: start; grid-column: 1 / -1; }
  @media (max-width: 480px) { .ex-filters { grid-template-columns: minmax(0, 1fr); } }
  .ex-title {
    font-size: clamp(30px, 3vw, 46px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ex-text {
    color: var(--ink-2);
    margin: 0;
    font-size: 16px;
    max-width: 52ch;
  }
  .ex-listhead {
    border-top: 1px solid var(--ink);
    padding-top: 12px;
    margin-bottom: 0;
  }
  .ex-zoom {
    position: absolute;
    left: 16px;
    top: 16px;
  }
  .ex-zoom .btn {
    background: var(--bg);
  }
  .ex-zoom .btn:hover {
    background: var(--ink);
  }
  .you {
    border: 1px solid var(--ink);
    padding: 14px 16px;
    display: grid;
    gap: 10px;
    margin-top: 4px;
  }
  .you-text {
    margin: 0;
    font-size: 15px;
    color: var(--ink-2);
  }
  .you-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .you-stat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 11.5px/1 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    background: none;
    border: 1px solid var(--line);
    padding: 7px 9px;
    cursor: pointer;
  }
  .you-stat b {
    font-weight: 600;
  }
  .you-stat:hover {
    border-color: var(--ink);
  }
  .you-stat[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .you-stat .hx,
  .you-stat .hx svg {
    width: 12px;
    height: 14px;
    cursor: inherit;
  }
  .you-stat[aria-pressed='true'] .hx path {
    stroke: var(--bg);
  }
  .you-stat[aria-pressed='true'][data-status='comfortable'] .hx path {
    fill: var(--bg);
  }
  .you .lit-chips {
    margin: 0;
  }
  .you-note {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }
  .chip.quiet {
    background: none;
    color: var(--ink);
    border: 1px solid var(--line);
    cursor: pointer;
  }
  .chip.quiet:hover {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .lit-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 6px 0 10px;
  }
  .chip {
    font: 500 12px/1 var(--mono);
    padding: 7px 9px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
  }
  .chip:hover {
    background: var(--ink);
    color: var(--bg);
  }
  @media (max-width: 900px) {
    .explorer {
      grid-template-columns: minmax(0, 1fr);
      height: auto;
    }
    .ex-map {
      height: 62dvh;
      min-height: 340px;
      border-bottom: 1px solid var(--ink);
    }
    .ex-panel {
      border-left: 0;
      padding: 0 var(--gutter) 40px;
    }
  }
</style>

<script>
  import { renderMap, computeView, nodeCodes, type MapAtlas } from '../../atlas/render.ts';
  import { matchesSkill, readFilters, type Focus, type ProgressFilter, type SkillFilters } from '../../atlas/filters.ts';
  import { STATUS_OPTIONS, type ProgressStatus } from '../../atlas/status.ts';
  import type { Geometry } from '../../atlas/geometry.ts';
  import { load, setStatus, applyProgress, onChange } from '../../scripts/progress.ts';
  import { track } from '../../scripts/track.ts';

  type Data = {
    territories: (MapAtlas['territories'][number] & { tagline: string; question: string })[];
    capabilities: (MapAtlas['capabilities'][number] & { description: string })[];
    skills: (MapAtlas['skills'][number] & { summary: string; focus: Focus[] })[];
    aliases: Record<string, string>;
    geometry: Geometry;
  };

  const mapEl = document.getElementById('ex-map')!;
  const $ = (id: string) => document.getElementById(id)!;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const HEX = '<path d="M11 1.2 20.8 6.8v11.4L11 23.8 1.2 18.2V6.8Z"></path>';

  let data: Data;
  let codes = new Map<string, string>();
  const T = new Map<string, Data['territories'][number]>();
  const C = new Map<string, Data['capabilities'][number]>();
  const S = new Map<string, Data['skills'][number]>();

  interface ExState extends SkillFilters {
    at: string;
    lit: string[];
  }
  let state: ExState = { at: '', lit: [], focus: '', progress: '' };

  function readUrl(): ExState {
    const q = new URLSearchParams(location.search);
    const alias = (id: string) => data?.aliases?.[id] ?? id;
    return {
      ...readFilters(q),
      at: alias(q.get('at') ?? ''),
      lit: (q.get('lit') ?? '').split(',').map((s) => alias(s.trim())).filter(Boolean),
    };
  }
  function urlFor(s: ExState) {
    const q = new URLSearchParams();
    if (s.at) q.set('at', s.at);
    if (s.focus) q.set('focus', s.focus);
    if (s.progress) q.set('progress', s.progress);
    if (s.lit.length) q.set('lit', s.lit.join(','));
    const qs = q.toString().replace(/%2C/g, ',');
    return `/atlas/${qs ? `?${qs}` : ''}`;
  }
  const pagePath = (id: string) => {
    const s = S.get(id);
    if (s) return `/atlas/${s.territory}/${s.capability}/${s.id}/`;
    const c = C.get(id);
    if (c) return `/atlas/${c.territory}/${c.id}/`;
    return `/atlas/${id}/`;
  };
  const nameOf = (id: string) => T.get(id)?.name ?? C.get(id)?.name ?? S.get(id)?.name ?? id;
  const codeOf = (id: string) => codes.get(id) ?? '';
  const upOf = (id: string) => (S.has(id) ? S.get(id)!.capability : C.has(id) ? C.get(id)!.territory : '');
  const levelKey = (at: string) => (S.has(at) ? S.get(at)!.capability : at);

  function size() {
    const r = mapEl.getBoundingClientRect();
    return { width: Math.max(320, Math.round(r.width)), height: Math.max(300, Math.round(r.height)) };
  }
  function options() {
    const { width, height } = size();
    const lit = state.lit.filter((id) => S.has(id) || C.has(id) || T.has(id));
    const progress = load(data.aliases).progress;
    const matches = state.focus || state.progress
      ? data.skills.filter((skill) => matchesSkill(skill, state, progress)).map((skill) => skill.id)
      : [];
    return {
      focus: state.at,
      width,
      height,
      scale: width < 520 ? 0.85 : 1,
      state: { progress, matches, lit, route: lit.length > 1, selected: S.has(state.at) ? state.at : null },
    };
  }
  function draw() {
    mapEl.innerHTML = renderMap(data, data.geometry, options());
    if (state.at) {
      const up = upOf(state.at);
      const div = document.createElement('div');
      div.className = 'ex-zoom';
      div.innerHTML = `<button class="btn small" type="button">← ${esc(up ? `${codeOf(up)} ${nameOf(up)}` : 'World')}</button>`;
      div.querySelector('button')!.addEventListener('click', () => go({ ...state, at: up }));
      mapEl.append(div);
    }
  }

  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  async function zoomTo(next: ExState) {
    const svg = mapEl.querySelector('svg');
    const same = levelKey(next.at) === levelKey(state.at);
    state = next;
    if (!svg || reduceMotion || same) return draw();
    const from = svg.viewBox.baseVal;
    const start = [from.x, from.y, from.width, from.height];
    const box = computeView(data, data.geometry, options()).box;
    const end = [box.x, box.y, box.w, box.h];
    mapEl.classList.add('is-zooming');
    mapEl.querySelector('.ex-zoom')?.remove();
    await new Promise<void>((resolve) => {
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / 480);
        const e = ease(t);
        svg.setAttribute('viewBox', start.map((s, i) => s + (end[i] - s) * e).join(' '));
        if (t < 1) requestAnimationFrame(step);
        else resolve();
      };
      requestAnimationFrame(step);
    });
    mapEl.classList.remove('is-zooming');
    mapEl.classList.add('is-entering');
    draw();
    requestAnimationFrame(() => requestAnimationFrame(() => mapEl.classList.remove('is-entering')));
  }

  function go(next: ExState, push = true) {
    if (push) history.pushState(next, '', urlFor(next));
    zoomTo(next).then(panel);
    track('Map zoom', { level: S.has(next.at) ? 'skill' : C.has(next.at) ? 'capability' : T.has(next.at) ? 'territory' : 'world' });
  }

  // ---- the index: the same rows as the static pages
  const skillCount = (count: number) => `${count} skill${count === 1 ? '' : 's'}`;
  const strip = (ids: string[]) =>
    `<span class="strip" aria-hidden="true">${ids.map((id) => `<a href="${pagePath(id)}" data-status-for="${id}" title="${codeOf(id)} ${esc(nameOf(id))}" tabindex="-1"></a>`).join('')}</span><span class="count" data-rollup="${ids.join(' ')}">${skillCount(ids.length)}</span>`;
  const outline = `<svg viewBox="0 0 22 25" width="22" height="25" aria-hidden="true"><path d="M11 1.2 20.8 6.8v11.4L11 23.8 1.2 18.2V6.8Z" fill="none" stroke="currentColor" stroke-width="1.2"></path></svg>`;
  const rowGroup = (id: string, sub: string, ids: string[]) =>
    `<li><div class="row" data-id="${id}">${outline}<span class="code">${codeOf(id)}</span><button class="name" type="button" data-go="${id}">${esc(nameOf(id))}</button><a class="go" href="${pagePath(id)}" aria-label="Open the ${esc(nameOf(id))} page">→</a><span class="sub">${esc(sub)}</span><span class="meta">${strip(ids)}</span></div></li>`;
  const rowSkill = (id: string, selected: boolean) =>
    `<li><div class="row${selected ? ' is-sel' : ''}" data-id="${id}" data-status-for="${id}"><button type="button" class="hx" data-cycle="${id}" data-name="${esc(nameOf(id))}" data-status-for="${id}"><svg viewBox="0 0 22 25" aria-hidden="true">${HEX}</svg></button><span class="code">${codeOf(id)}</span><button class="name" type="button" data-go="${id}">${esc(nameOf(id))}</button><a class="go" href="${pagePath(id)}" aria-label="Open the ${esc(nameOf(id))} page">→</a><span class="sub">${esc(S.get(id)!.summary)}</span></div></li>`;
  const tSkills = (tid: string) => T.get(tid)!.capabilities.flatMap((c) => C.get(c)!.skills);

  // ---- your map: what you marked, shown at the world level. Each count filters the map.
  const STATS = [
    ['learning', 'learning'],
    ['comfortable', 'comfortable'],
    ['not-interested', 'not interested'],
    ['none', 'not started'],
  ] as const;
  const LEARNING_CHIPS = 12;
  function yourMap(progress: Record<string, string>) {
    const count = (value: string) => data.skills.filter((skill) => (progress[skill.id] ?? 'none') === value).length;
    const marked = data.skills.length - count('none');
    const save = '<p class="you-note"><span class="anon-only">Saved in this browser. <a href="/me/#account">Sign in</a> to keep it on every device.</span><span class="account-only">Saved to your account. <a href="/me/">Account settings</a></span></p>';
    if (!marked)
      return `<div class="you"><div class="label">Your map</div><p class="you-text">Open a capability and click the hexagon next to a skill to mark it as learning, comfortable or not interested. Your map fills in as you go.</p>${save}</div>`;
    const stats = STATS.map(([value, label]) => {
      const on = state.progress === value;
      return `<button type="button" class="you-stat" data-status="${value}" data-progress="${value}" aria-pressed="${on}"><span class="hx" aria-hidden="true"><svg viewBox="0 0 22 25">${HEX}</svg></span><b>${count(value)}</b> ${label}</button>`;
    }).join('');
    const learning = data.skills.filter((skill) => progress[skill.id] === 'learning');
    const more = learning.length - LEARNING_CHIPS;
    const chips = learning.length
      ? `<div class="label">Learning now</div><div class="lit-chips">${learning
          .slice(0, LEARNING_CHIPS)
          .map((skill) => `<a class="chip quiet" href="${urlFor({ ...state, at: skill.id })}" data-go="${skill.id}">${codeOf(skill.id)} ${esc(skill.name)}</a>`)
          .join('')}${more > 0 ? `<button type="button" class="chip quiet" data-progress="learning">+${more} more</button>` : ''}</div>`
      : '';
    return `<div class="you"><div class="label">Your map · ${marked} of ${data.skills.length} marked</div><div class="you-stats">${stats}</div>${chips}${save}</div>`;
  }

  function panel() {
    const focused = document.activeElement as HTMLElement | null;
    const focusedStatus = focused?.matches('input[name="ex-status"]') ? (focused as HTMLInputElement).value : undefined;
    const focusedCycle = focused?.dataset.cycle;
    ($('ex-focus') as HTMLSelectElement).value = state.focus;
    ($('ex-progress') as HTMLSelectElement).value = state.progress;
    const progress = load(data.aliases).progress;
    const matching = new Set(data.skills.filter((skill) => matchesSkill(skill, state, progress)).map((skill) => skill.id));
    const filtered = (ids: string[]) => ids.filter((id) => matching.has(id));
    const active = !!(state.focus || state.progress);
    $('ex-reset-filters').hidden = !active;
    const at = state.at;
    const skill = S.get(at);
    const cap = C.get(skill ? skill.capability : at);
    const terr = T.get(cap ? cap.territory : at);
    const crumb = (id: string, label: string) => `<a href="${urlFor({ ...state, at: id })}" data-go="${id}">${esc(label)}</a>`;
    const sep = '<span class="sep" aria-hidden="true">/</span>';
    const crumbs = ['<a href="/atlas/" data-go="">Skills Map</a>'];
    if (terr) crumbs.push(crumb(terr.id, `${codeOf(terr.id)} ${terr.name}`));
    if (cap) crumbs.push(crumb(cap.id, `${codeOf(cap.id)} ${cap.name}`));
    $('ex-crumbs').innerHTML = crumbs.join(sep);

    let code = `Skills Map · ${data.skills.length} skills`;
    let title = 'Skills Map';
    let text = 'Explore the skills of product engineering, including AI. Pick a territory to see its capabilities and skills.';
    let actions = yourMap(progress);
    let listTitle = 'Territories';
    let list = data.territories.filter((t) => filtered(tSkills(t.id)).length).map((t) => rowGroup(t.id, t.question, filtered(tSkills(t.id)))).join('');

    if (terr && !cap) {
      code = `${codeOf(terr.id)} · ${terr.crossCutting ? 'Cross-cutting' : 'Territory'} · ${terr.tagline}`;
      title = terr.name;
      text = esc(terr.question);
      actions = `<a class="btn small" href="${pagePath(terr.id)}">Open the territory page →</a>`;
      const count = terr.capabilities.filter((id) => filtered(C.get(id)!.skills).length).length;
      listTitle = `${count} capabilit${count === 1 ? 'y' : 'ies'}${active ? (count === 1 ? ' matches' : ' match') : ''}`;
      list = terr.capabilities.filter((id) => filtered(C.get(id)!.skills).length).map((id) => rowGroup(id, C.get(id)!.description, filtered(C.get(id)!.skills))).join('');
    } else if (cap) {
      code = skill ? `${codeOf(skill.id)} · Skill in ${cap.name}` : `${codeOf(cap.id)} · Capability in ${terr!.name}`;
      title = skill ? skill.name : cap.name;
      text = esc(skill ? skill.summary : cap.description);
      actions = skill
        ? `<div class="seg" role="radiogroup" aria-label="Your status">${(
            STATUS_OPTIONS
          )
            .map(({ value, label, cls }) => `<label><input type="radio" name="ex-status" value="${value}" data-status-input="${skill.id}"><span class="${cls}"><svg viewBox="0 0 22 25" aria-hidden="true">${HEX}</svg>${label}</span></label>`)
            .join('')}</div><div class="btn-row" style="margin-top:4px"><a class="btn small" href="${pagePath(skill.id)}">Open the skill page →</a></div>`
        : `<a class="btn small" href="${pagePath(cap.id)}">Open the capability page →</a>`;
      const count = filtered(cap.skills).length;
      listTitle = `${skillCount(count)}${active ? (count === 1 ? ' matches' : ' match') : ''}`;
      list = filtered(cap.skills).map((id) => rowSkill(id, id === at)).join('');
    }

    const scope = cap ? cap.skills : terr ? tSkills(terr.id) : data.skills.map((skill) => skill.id);
    $('ex-filter-note').textContent = active
      ? `${filtered(scope).length} of ${scope.length} skills match. Matching skills have yellow backgrounds on the map.`
      : 'Focus areas overlap. Combine focus with your progress.';
    $('ex-code').textContent = code;
    $('ex-title').textContent = title;
    $('ex-text').innerHTML = text;
    $('ex-actions').innerHTML = actions;
    $('ex-list-title').textContent = listTitle;
    $('ex-list-count').textContent = cap && !skill ? 'Click a hexagon to set your status' : '';
    $('ex-list').innerHTML = list ? `<ul class="index${cap ? ' big' : ''}">${list}</ul>` : '<p class="empty">No skills here match these filters. Clear the filters or explore another territory.</p>';

    const lit = state.lit.filter((id) => S.has(id) || C.has(id) || T.has(id));
    $('ex-lit').innerHTML = lit.length
      ? `<div class="label">Lit on this map, in order</div><div class="lit-chips">${lit
          .map((id) => `<a class="chip" href="${urlFor({ ...state, at: id })}" data-go="${id}">${codeOf(id)} ${esc(nameOf(id))}</a>`)
          .join('')}</div><div class="btn-row"><button class="btn small" type="button" id="ex-copy">Copy link</button><button class="btn small" type="button" id="ex-clear">Clear</button></div>`
      : '';
    $('ex-copy')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(new URL(urlFor(state), location.origin).href);
        $('ex-copy').textContent = 'Copied';
      } catch {
        $('ex-copy').textContent = 'Copy failed';
      }
    });
    $('ex-clear')?.addEventListener('click', () => go({ ...state, lit: [] }));
    $('ex-actions').querySelectorAll<HTMLButtonElement>('button[data-progress]').forEach((button) =>
      button.addEventListener('click', () => {
        const value = button.dataset.progress as ProgressFilter;
        go({ ...state, progress: state.progress === value && button.hasAttribute('aria-pressed') ? '' : value });
        track('Your map filter', { status: value });
      }),
    );
    document.querySelectorAll<HTMLInputElement>('input[name="ex-status"]').forEach((input) =>
      input.addEventListener('change', () => {
        if (!input.checked) return;
        setStatus(input.dataset.statusInput!, input.value as ProgressStatus);
        track('Status set', { status: input.value, from: 'map' });
      }),
    );
    applyProgress();
    if (focusedStatus) document.querySelector<HTMLInputElement>(`input[name="ex-status"][value="${focusedStatus}"]`)?.focus();
    if (focusedCycle) {
      const button = $('ex-list').querySelector<HTMLButtonElement>(`button[data-cycle="${focusedCycle}"]`);
      (button ?? $('ex-progress')).focus();
    }
  }

  // ---- events
  for (const id of ['ex-focus', 'ex-progress']) {
    $(id).addEventListener('change', () => {
      if (!data) return;
      const query = new URLSearchParams({
        focus: ($('ex-focus') as HTMLSelectElement).value,
        progress: ($('ex-progress') as HTMLSelectElement).value,
      });
      go({ ...state, ...readFilters(query) });
    });
  }
  $('ex-reset-filters').addEventListener('click', () => go({ ...state, focus: '', progress: '' }));
  document.addEventListener('click', (e) => {
    const me = e as MouseEvent;
    if (me.metaKey || me.ctrlKey || me.shiftKey || !data) return;
    const target = e.target as Element;
    if (target.closest('button[data-cycle], a.go, .strip a')) return;
    const goEl = target.closest<HTMLElement>('#ex-panel [data-go]');
    if (goEl) {
      e.preventDefault();
      go({ ...state, at: goEl.dataset.go! });
      return;
    }
    const node = target.closest<SVGElement>('#ex-map [data-id]');
    if (node) {
      e.preventDefault();
      go({ ...state, at: node.dataset.id! });
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !state.at || (e.target as Element).closest('input, textarea, select')) return;
    go({ ...state, at: upOf(state.at) });
  });
  window.addEventListener('popstate', () => data && zoomTo(readUrl()).then(panel));

  let resizeTimer: number | undefined;
  new ResizeObserver(() => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => data && draw(), 120);
  }).observe(mapEl);
  onChange(() => { if (data) { draw(); panel(); } });

  fetch('/atlas-data.json')
    .then((r) => r.json())
    .then((d: Data) => {
      data = d;
      codes = nodeCodes(d);
      d.territories.forEach((t) => T.set(t.id, t));
      d.capabilities.forEach((c) => C.set(c.id, c));
      d.skills.forEach((s) => S.set(s.id, s));
      state = readUrl();
      if (state.at && !T.has(state.at) && !C.has(state.at) && !S.has(state.at)) state.at = '';
      ($('ex-focus') as HTMLSelectElement).disabled = false;
      ($('ex-progress') as HTMLSelectElement).disabled = false;
      history.replaceState(state, '', urlFor(state));
      draw();
      panel();
      if (state.lit.length) track('Lit map opened', { count: state.lit.length });
    })
    .catch(() => { $('ex-filter-note').textContent = 'Filters could not load. Reload the page to try again.'; });
</script>
