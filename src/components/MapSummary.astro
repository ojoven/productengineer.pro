---
// "On the map" in a profile: every territory the piece covers, and under it each skill with one
// sentence on how the product applied it. Reads the coverage EntryPage resolved for this entry, so
// the front matter stays the only place the notes are written. MDX: <MapSummary />.
const coverage = Astro.locals.coverage;
const sections = coverage?.sections ?? [];
---

{
  sections.length > 0 && (
    <div class="map-summary">
      {sections.map((s) => (
        <section class="ms-group" aria-label={s.territory?.name ?? s.section}>
          <a class="ms-head" href={s.anchor}>
            <span class="ms-code">{s.territory?.code ?? '·'}</span>
            <span class="ms-name">{s.territory?.name ?? s.section}</span>
            <span class="ms-count">{s.scope === 'general' ? 'Wider discussion' : `${s.skills.length} ${s.skills.length === 1 ? 'skill' : 'skills'}`}</span>
          </a>
          <dl class="ms-skills">
            {s.skills.map((k) => (
              <div>
                <dt>
                  <a href={k.url} data-status-for={k.id}>
                    <i aria-hidden="true" />
                    {k.name}
                  </a>
                </dt>
                <dd>{k.note ?? ''}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  )
}

<style>
  .map-summary {
    margin: 28px 0 36px;
    border-top: 1px solid var(--ink);
  }
  .ms-group {
    border-bottom: 1px solid var(--line);
    padding: 14px 0 12px;
  }
  .ms-head {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    color: var(--ink);
  }
  .ms-head:hover .ms-name {
    color: var(--accent-ink);
  }
  .ms-code,
  .ms-count {
    font: 400 11px/1 var(--mono);
    color: var(--muted);
  }
  .ms-count {
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ms-name {
    font: 600 19px/1.2 var(--cond);
  }
  .ms-skills {
    margin: 8px 0 0 38px;
    padding: 0;
  }
  .ms-skills div {
    display: grid;
    grid-template-columns: minmax(150px, 30%) minmax(0, 1fr);
    gap: 4px 16px;
    padding: 5px 0;
  }
  .ms-skills dt,
  .ms-skills dd {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.45;
  }
  .ms-skills dd {
    color: var(--ink-2, var(--ink));
  }
  .ms-skills a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font: 600 15px/1.3 var(--cond);
    color: var(--ink);
    text-decoration: none;
  }
  .ms-skills a:hover {
    color: var(--accent-ink);
  }
  .ms-skills a i {
    width: 9px;
    height: 10.4px;
    flex: none;
    align-self: center;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--tile-hover);
  }
  .ms-skills a[data-status='learning'] i {
    background: var(--learning);
  }
  .ms-skills a[data-status='comfortable'] i {
    background: var(--ink);
  }
  @media (max-width: 640px) {
    .ms-skills {
      margin-left: 0;
    }
    .ms-skills div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
