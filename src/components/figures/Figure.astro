---
// The frame every figure sits in: a numbered plate with a title above and, below, how the content
// is known and what to read from it. Use it directly to give any content (an image, a table, a
// one-off SVG) the same frame.
import './figures.css';
import { EVIDENCE, uid, type FrameProps } from './lib.ts';
import Hex from './Hex.astro';

interface Props extends FrameProps {
  /** The label after the figure number: FUNNEL, WALKTHROUGH. */
  kind?: string;
  /** Component slug, for the root class `fg-<name>`. */
  name?: string;
  /** Reveals once when scrolled into view. */
  animate?: boolean;
  /** Has continuous motion (particles) and shows a Pause button. */
  ambient?: boolean;
  /** A sentence for screen readers when the body is a drawing. */
  label?: string;
  class?: string;
}
const { kind = 'Figure', name, title, caption, evidence, source, animate = false, replay = false, ambient = false, label, class: className } = Astro.props;
// Replay only where the reveal itself says something: an order, a sequence, a drop step by step.
const showReplay = animate && replay;
const titleId = title ? uid('fg-title') : undefined;
const hasFoot = !!(caption || evidence || source) || Astro.slots.has('foot');
---

<figure
  class:list={['fg', name && `fg-${name}`, className]}
  data-fg
  data-animate={animate ? '' : undefined}
  data-ambient={ambient ? '' : undefined}
  aria-labelledby={titleId}
  aria-label={!title ? (label ?? kind) : undefined}
>
  <script is:inline>
    document.documentElement.classList.add('fg-js');
  </script>
  <div class="fg-head">
    <div class="fg-meta"><span class="fg-no"></span><span class="fg-kind">{kind}</span></div>
    {
      (showReplay || ambient) && (
        <div class="fg-controls">
          {showReplay && (
            <button type="button" class="fg-ctl" data-fg-replay hidden>
              <svg viewBox="0 0 12 12" aria-hidden="true">
                <path d="M10.2 6a4.2 4.2 0 1 1-1.3-3" />
                <path d="M9.4 0.8v2.6H6.8" />
              </svg>
              Replay
            </button>
          )}
          {ambient && (
            <button type="button" class="fg-ctl" data-fg-pause aria-label="Pause animation" title="Pause animation" hidden>
              <svg viewBox="0 0 12 12" aria-hidden="true">
                <path class="i-pause" d="M2.5 1.5h2.5v9H2.5zM7 1.5h2.5v9H7z" />
                <path class="i-play" d="M3 1.5 10.5 6 3 10.5z" />
              </svg>
            </button>
          )}
        </div>
      )
    }
    {title && <p class="fg-title" id={titleId}>{title}</p>}
  </div>
  <div class="fg-body"><slot /></div>
  {
    hasFoot && (
      <figcaption class="fg-foot">
        <slot name="foot" />
        {caption && <p class="fg-caption">{caption}</p>}
        {(evidence || source) && (
          <p class="fg-source">
            {evidence && (
              <span class:list={['fg-ev', `fg-ev-${evidence}`]}>
                <Hex />
                {EVIDENCE[evidence]}
              </span>
            )}
            {source && <span>{source}</span>}
          </p>
        )}
      </figcaption>
    )
  }
</figure>

<script>
  import { initFigures } from './motion.ts';
  initFigures();
</script>
