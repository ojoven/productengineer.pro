---
// A loop: stages that feed each other in a circle, with a dot going round. For a core usage
// loop, a referral loop, a feedback loop, build-measure-learn.
import Figure from './Figure.astro';
import { hexPath, round, uid, type FrameProps } from './lib.ts';

interface Stage {
  label: string;
  /** What happens at this stage, in one line. */
  note?: string;
  /** signal: the stage that is weak or under test. lit: where the value is. */
  tone?: 'signal' | 'lit';
}
interface Props extends FrameProps {
  /** Three to six stages, clockwise from the top. */
  stages: Stage[];
  /** What goes round, written in the middle: "Core loop", "Referral". */
  center?: string;
  /** A second, smaller line in the middle: how long one turn takes. */
  sub?: string;
  /** Set to false for a still diagram. */
  motion?: boolean;
}
const { stages, center, sub, motion = true, ...frame } = Astro.props;
const n = stages.length;
const C = 150;
const R = 104;
const key = uid('loop');
const angle = (i: number) => -Math.PI / 2 + (i * 2 * Math.PI) / n;
const at = (a: number, r = R): [number, number] => [round(C + r * Math.cos(a)), round(C + r * Math.sin(a))];
const pad = 0.24; // radians kept clear on each side of a stage marker
const arcs = stages.map((_, i) => {
  const [x0, y0] = at(angle(i) + pad);
  const [x1, y1] = at(angle(i + 1) - pad);
  return `M${x0} ${y0}A${R} ${R} 0 0 1 ${x1} ${y1}`;
});
const [tx, ty] = at(-Math.PI / 2);
const ring = `M${tx} ${ty}A${R} ${R} 0 1 1 ${round(tx - 0.01)} ${ty}`;
const summary = `${center ?? 'Loop'}: ${stages.map((s) => s.label).join(', then ')}, and round again.`;
---

<Figure kind="Loop" name="loop" animate ambient={motion} {...frame}>
  <div class="x-wrap">
    <svg class="x-ring" viewBox="0 0 300 300" role="img" aria-label={summary}>
      <defs>
        <marker id={`${key}-a`} viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto">
          <path class="x-head" d="M1 1 7 4 1 7" />
        </marker>
      </defs>
      {arcs.map((d, i) => <path class="x-arc" d={d} marker-end={`url(#${key}-a)`} pathLength="1" data-a="draw" style={`--i:${i};--a-step:160ms;--a-dur:500ms`} />)}
      {
        motion && (
          <circle class="fg-particle" r="4.5">
            <animateMotion path={ring} dur={`${Math.max(6, n * 2.2)}s`} begin="indefinite" repeatCount="indefinite" data-ambient-start="0" />
          </circle>
        )
      }
      {
        stages.map((s, i) => {
          const [x, y] = at(angle(i));
          return (
            <g class:list={['x-stage', s.tone && `t-${s.tone}`]} data-a="pop" style={`--i:${i};--a-step:160ms`}>
              <path d={hexPath(x, y, 17)} />
              <text x={x} y={y + 4.5} text-anchor="middle">
                {i + 1}
              </text>
            </g>
          );
        })
      }
      {
        center && (
          <text class="x-center" x={C} y={sub ? C - 1 : C + 6} text-anchor="middle">
            {center}
          </text>
        )
      }
      {
        sub && (
          <text class="t-label" x={C} y={C + 17} text-anchor="middle">
            {sub}
          </text>
        )
      }
    </svg>
    <ol class="x-list">
      {
        stages.map((s, i) => (
          <li>
            <span class:list={['fg-hex', s.tone === 'signal' ? 'is-signal' : s.tone === 'lit' ? 'is-lit' : 'is-ink']}>{i + 1}</span>
            <span class="x-text">
              <span class="x-name">{s.label}</span>
              {s.note && <span class="x-note">{s.note}</span>}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</Figure>

<style is:global>
  .fg-loop .x-wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    gap: 28px;
    align-items: center;
  }
  .fg-loop .x-ring {
    display: block;
    width: 100%;
    max-width: 300px;
    height: auto;
    overflow: visible;
  }
  .fg-loop .x-arc {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .fg-loop .x-head {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
  }
  .fg-loop .x-stage path {
    fill: var(--ink);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .fg-loop .x-stage text {
    font: 500 12px var(--mono);
    fill: var(--bg);
  }
  .fg-loop .x-stage.t-signal path {
    fill: var(--accent);
  }
  .fg-loop .x-stage.t-signal text {
    fill: var(--fg-on-signal);
  }
  .fg-loop .x-stage.t-lit path {
    fill: var(--fg-lit);
  }
  .fg-loop .x-stage.t-lit text {
    fill: var(--fg-on-lit);
  }
  .fg-loop svg .x-center {
    font: 600 22px var(--cond);
    letter-spacing: -0.01em;
    fill: var(--ink);
  }
  .fg-loop .x-list li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
  }
  .fg-loop .x-list li:first-child {
    padding-top: 0;
  }
  .fg-loop .x-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .fg-loop .x-text {
    display: grid;
    gap: 1px;
    padding-top: 2px;
  }
  .fg-loop .x-name {
    font: 600 17px/1.2 var(--cond);
  }
  .fg-loop .x-note {
    font-size: 13.5px;
    color: var(--ink-2);
  }
  @container fg (max-width: 519px) {
    .fg-loop .x-wrap {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
    .fg-loop .x-ring {
      max-width: 250px;
      margin-inline: auto;
    }
  }
</style>
