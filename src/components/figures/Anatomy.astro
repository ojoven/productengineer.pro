---
// A piece of text taken apart: a prompt, a line of microcopy, an email, a landing-page headline.
// Parts with a label are marked in the text and explained in the list.
import Figure from './Figure.astro';
import type { FrameProps } from './lib.ts';

interface Part {
  /** The words, exactly as they appear. Line breaks are kept. */
  text: string;
  /** What this part is: "Role", "Constraint", "Call to action". Parts without a label are plain text. */
  label?: string;
  /** What it does, or what is wrong with it. */
  note?: string;
  /** signal: the part to look at (pink). lit: the part that works (yellow). Default: ink. */
  kind?: 'ink' | 'signal' | 'lit';
}
interface Props extends FrameProps {
  parts: Part[];
  /** prompt: monospace, for prompts and code. copy: the reading face, for interface and marketing text. Default "copy". */
  as?: 'copy' | 'prompt';
}
const { parts, as = 'copy', ...frame } = Astro.props;
let n = 0;
const list = parts.map((p) => ({ ...p, n: p.label ? ++n : 0, kind: p.kind ?? 'ink' }));
const marked = list.filter((p) => p.n);
---

<Figure kind="Anatomy" name="anatomy" animate {...frame}>
  <div class:list={['x-wrap', `is-${as}`]}>
    <p class="x-text">
      {
        list.map((p) =>
          p.n ? (
            <mark class={`is-${p.kind}`}>
              {p.text}
              <sup>{p.n}</sup>
            </mark>
          ) : (
            <span>{p.text}</span>
          ),
        )
      }
    </p>
    <ol class="x-notes">
      {
        marked.map((p, i) => (
          <li data-a="rise" style={`--i:${i}`}>
            <span class:list={['fg-hex', p.kind === 'signal' ? 'is-signal' : p.kind === 'lit' ? 'is-lit' : 'is-ink']}>{p.n}</span>
            <span class="x-body">
              <span class="x-label">{p.label}</span>
              {p.note && <span class="x-note">{p.note}</span>}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</Figure>

<style is:global>
  .fg-anatomy .x-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .fg-anatomy .x-text {
    border: 1px solid var(--ink);
    background: var(--bg-2);
    padding: 16px 18px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font: 500 19px/1.6 var(--cond);
    color: var(--ink);
  }
  .fg-anatomy .is-prompt .x-text {
    font: 400 13px/1.85 var(--mono);
  }
  .fg-anatomy mark {
    background: none;
    color: inherit;
    padding: 1px 0;
    box-shadow: inset 0 -2px 0 var(--ink);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .fg-anatomy mark.is-signal {
    box-shadow: inset 0 -3px 0 var(--accent);
  }
  .fg-anatomy mark.is-lit {
    background: color-mix(in srgb, var(--fg-lit) 60%, transparent);
    box-shadow: none;
    padding: 1px 2px;
  }
  .fg-anatomy sup {
    font: 500 10px/1 var(--mono);
    color: var(--accent-ink);
    margin-left: 2px;
    vertical-align: super;
  }
  .fg-anatomy .x-notes li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .fg-anatomy .x-notes li:first-child {
    padding-top: 0;
  }
  .fg-anatomy .x-notes li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .fg-anatomy .x-body {
    display: grid;
    gap: 1px;
    padding-top: 2px;
  }
  .fg-anatomy .x-label {
    font: 600 16px/1.2 var(--cond);
  }
  .fg-anatomy .x-note {
    font-size: 13.5px;
    color: var(--ink-2);
  }
  @container fg (max-width: 519px) {
    .fg-anatomy .x-wrap {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .fg-anatomy .x-text {
      font-size: 17px;
      padding: 12px 14px;
    }
    .fg-anatomy .is-prompt .x-text {
      font-size: 12px;
    }
  }
</style>
