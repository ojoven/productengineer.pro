---
// A journey: the steps a person goes through and how each one feels, as a line that rises and
// falls. The lowest point is where the product loses them; the highest is where it pays off.
import Figure from './Figure.astro';
import { VARIANTS, WIDTHS, hexPath, round, scale, uid, type FrameProps, type Variant } from './lib.ts';

interface Step {
  label: string;
  /** How it goes for the person, from -2 (stuck, annoyed) to 2 (it clicks). 0 is neutral. */
  feel: number;
  note?: string;
  /** A stage name. Consecutive steps with the same phase are grouped under it. */
  phase?: string;
}
interface Props extends FrameProps {
  steps: Step[];
  /** Words at the two ends of the scale. Default "Harder" and "Easier". */
  ends?: { low?: string; high?: string };
  /** Set to false to leave the lowest and highest steps unmarked. */
  mark?: boolean;
}
const { steps, ends, mark = true, ...frame } = Astro.props;
const n = steps.length;
const feels = steps.map((s) => Math.max(-2, Math.min(2, s.feel)));
const lowAt = mark ? feels.indexOf(Math.min(...feels)) : -1;
const highAt = mark ? feels.indexOf(Math.max(...feels)) : -1;
const tone = (i: number) => (i === lowAt && feels[i] < 0 ? 'signal' : i === highAt && feels[i] > 0 ? 'lit' : 'ink');
// consecutive steps with the same phase
const phases: { label: string; from: number; to: number }[] = [];
steps.forEach((s, i) => {
  const last = phases[phases.length - 1];
  if (s.phase && last && last.label === s.phase && last.to === i - 1) last.to = i;
  else if (s.phase) phases.push({ label: s.phase, from: i, to: i });
});

function layout(v: Variant) {
  const W = WIDTHS[v];
  const wide = v === 'wide';
  const m = { l: wide ? 64 : 20, r: 20, t: phases.length ? 34 : 18, b: 18 };
  const H = wide ? 200 : 180;
  const px = scale(0, Math.max(1, n - 1), m.l, W - m.r);
  const py = scale(-2, 2, H - m.b, m.t);
  const pts = feels.map((f, i) => [round(px(i)), round(py(f))] as const);
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < n; i++) {
    const mid = round((pts[i - 1][0] + pts[i][0]) / 2);
    d += `C${mid} ${pts[i - 1][1]} ${mid} ${pts[i][1]} ${pts[i][0]} ${pts[i][1]}`;
  }
  const zero = round(py(0));
  const area = `${d}L${pts[n - 1][0]} ${zero}L${pts[0][0]} ${zero}Z`;
  const step = n > 1 ? px(1) - px(0) : 0;
  return { v, W, H, m, pts, d, area, zero, wide, key: uid('jrn'), bands: phases.map((p) => ({ ...p, x0: round(px(p.from) - Math.min(step / 2 - 3, 20)), x1: round(px(p.to) + Math.min(step / 2 - 3, 20)) })) };
}
const layouts = VARIANTS.map(layout);
const word = (f: number) => (f <= -1.5 ? 'stuck' : f < 0 ? 'harder' : f === 0 ? 'neutral' : f < 1.5 ? 'easier' : 'it clicks');
const summary = `${frame.title ? frame.title + '. ' : ''}Journey: ${steps.map((s, i) => `${i + 1}, ${s.label} (${word(feels[i])})`).join('; ')}.`;
---

<Figure kind="Journey" name="journey" animate replay {...frame}>
  {
    layouts.map((L) => (
      <svg class={`fg-svg fg-${L.v}`} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-label={summary}>
        <defs>
          <clipPath id={`${L.key}-up`}>
            <rect x="0" y="0" width={L.W} height={L.zero} />
          </clipPath>
          <clipPath id={`${L.key}-down`}>
            <rect x="0" y={L.zero} width={L.W} height={L.H - L.zero} />
          </clipPath>
        </defs>
        {L.bands.map((b) => (
          <g>
            <line class="s-axis" x1={b.x0} x2={b.x1} y1="16" y2="16" />
            <text class="t-label" x={b.x0} y="10">
              {b.label}
            </text>
          </g>
        ))}
        <path class="x-up" d={L.area} clip-path={`url(#${L.key}-up)`} data-a="fade" style="--a-delay:700ms" />
        <path class="x-down" d={L.area} clip-path={`url(#${L.key}-down)`} data-a="fade" style="--a-delay:700ms" />
        <line class="s-grid" x1={L.m.l - 12} x2={L.W - L.m.r + 12} y1={L.zero} y2={L.zero} />
        {L.wide && (
          <>
            <text class="t-label" x="0" y={L.m.t + 4}>
              {ends?.high ?? 'Easier'}
            </text>
            <text class="t-label" x="0" y={L.H - L.m.b + 3}>
              {ends?.low ?? 'Harder'}
            </text>
          </>
        )}
        <path class="s-ink" d={L.d} pathLength="1" data-a="draw" style="--a-dur:1200ms" />
        {L.pts.map(([x, y], i) => (
          <g class={`x-pt t-${tone(i)}`} data-a="pop" style={`--i:${i};--a-step:120ms;--a-delay:200ms`}>
            <path d={hexPath(x, y, 12.5)} />
            <text x={x} y={y + 4} text-anchor="middle">
              {i + 1}
            </text>
          </g>
        ))}
      </svg>
    ))
  }
  <ol class="x-list">
    {
      steps.map((s, i) => (
        <li>
          <span class:list={['fg-hex', `is-${tone(i)}`]}>{i + 1}</span>
          <span class="x-text">
            <span class="x-name">
              {s.label}
              {tone(i) === 'signal' && <span class="fg-tag is-signal">Low point</span>}
              {tone(i) === 'lit' && <span class="fg-tag is-lit">High point</span>}
            </span>
            {s.note && <span class="x-note">{s.note}</span>}
          </span>
        </li>
      ))
    }
  </ol>
</Figure>

<style is:global>
  .fg-journey svg .x-up {
    fill: var(--tile);
  }
  .fg-journey svg .x-down {
    fill: color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .fg-journey .x-pt path {
    fill: var(--ink);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .fg-journey svg .x-pt text {
    font: 500 10.5px var(--mono);
    fill: var(--bg);
  }
  .fg-journey .x-pt.t-signal path {
    fill: var(--accent);
  }
  .fg-journey svg .x-pt.t-signal text {
    fill: var(--fg-on-signal);
  }
  .fg-journey .x-pt.t-lit path {
    fill: var(--fg-lit);
  }
  .fg-journey svg .x-pt.t-lit text {
    fill: var(--fg-on-lit);
  }
  .fg-journey .x-list {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 28px;
    border-top: 1px solid var(--line);
  }
  .fg-journey .x-list li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
  }
  .fg-journey .x-text {
    display: grid;
    gap: 2px;
    padding-top: 2px;
  }
  .fg-journey .x-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font: 600 16px/1.2 var(--cond);
  }
  .fg-journey .x-note {
    font-size: 13.5px;
    color: var(--ink-2);
  }
  @container fg (max-width: 519px) {
    .fg-journey .x-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
