---
// The connectors, with what the agent reads from each and what it may write.
import Brand from './Brand.astro';
import { ICONS, type IconId } from './icons.ts';

const connectors: { id: IconId; reads: string; writes?: string }[] = [
  { id: 'github', reads: 'Code, pull requests and deploys.', writes: 'Opens pull requests' },
  { id: 'googleanalytics', reads: 'Traffic, sources and conversions.' },
  { id: 'posthog', reads: 'Events, funnels, sessions and experiments.' },
  { id: 'mixpanel', reads: 'Events, funnels and cohorts.' },
  { id: 'stripe', reads: 'Plans, upgrades, churn and revenue.' },
  { id: 'sentry', reads: 'Errors and the users they reach.' },
  { id: 'vercel', reads: 'Deploys and page speed.' },
  { id: 'linear', reads: 'The backlog and its status.', writes: 'Creates issues' },
  { id: 'googleads', reads: 'Campaigns, spend and conversions.', writes: 'Drafts changes' },
  { id: 'meta', reads: 'Campaigns, spend and conversions.', writes: 'Drafts changes' },
  { id: 'linkedin', reads: 'Posts, reach and clicks.', writes: 'Drafts posts' },
  { id: 'x', reads: 'Posts, reach and clicks.', writes: 'Drafts posts' },
  { id: 'googlesearchconsole', reads: 'Search queries, rankings and clicks.' },
  { id: 'intercom', reads: 'Support conversations.' },
  { id: 'hotjar', reads: 'Recordings and surveys.' },
  { id: 'slack', reads: 'Where it reports and asks.', writes: 'Posts updates' },
];
// The brand colour shows on hover, except for near-black marks, which would vanish in dark mode.
const hover = (id: IconId) => {
  const hex = ICONS[id].hex;
  const n = parseInt(hex, 16);
  const light = 0.299 * (n >> 16) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255);
  return light > 60 ? `#${hex}` : undefined;
};
---

<ul class="connectors">
  {
    connectors.map((c) => (
      <li style={hover(c.id) ? `--brand:${hover(c.id)}` : undefined}>
        <span class="c-mark"><Brand id={c.id} size={22} /></span>
        <span class="c-text">
          <strong>{ICONS[c.id].title}</strong>
          <span>{c.reads}</span>
          {c.writes && <em>{c.writes}, after your yes</em>}
        </span>
      </li>
    ))
  }
</ul>
<p class="c-note">Read-only access unless you choose more. Your engineer checks each source with a real query before the agent uses it.</p>

<style>
  .connectors {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
  }
  .connectors li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 16px 14px 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .c-mark {
    width: 44px;
    height: 44px;
    flex: none;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    color: var(--ink);
    transition: color 0.15s, border-color 0.15s;
  }
  .connectors li:hover .c-mark {
    color: var(--brand, var(--ink));
    border-color: var(--ink);
  }
  .c-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .c-text strong {
    font: 600 17px/1.2 var(--cond);
  }
  .c-text span {
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .c-text em {
    font: normal 11px/1.5 var(--mono);
    color: var(--accent-ink);
  }
  .c-note {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .connectors {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .connectors {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 420px) {
    .connectors {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
