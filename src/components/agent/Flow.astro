---
// How it works: sources and context go in, reviewed work comes out.
import Brand from './Brand.astro';
import type { IconId } from './icons.ts';
import { hexPath } from './sample.ts';

const sources: { label: string; icons: IconId[] }[] = [
  { label: 'Analytics', icons: ['googleanalytics', 'posthog', 'mixpanel'] },
  { label: 'Code and delivery', icons: ['github', 'sentry', 'vercel'] },
  { label: 'Revenue and backlog', icons: ['stripe', 'linear'] },
  { label: 'Channels', icons: ['googleads', 'meta', 'linkedin', 'x', 'googlesearchconsole'] },
  { label: 'Users', icons: ['intercom', 'hotjar'] },
];
const outputs: { label: string; detail: string; icon?: IconId; kind?: 'score' | 'doc' }[] = [
  { label: 'Health score', detail: 'Every day', kind: 'score' },
  { label: 'Weekly review', detail: 'Monday, in your repo', kind: 'doc' },
  { label: 'Pull requests', detail: 'In GitHub, never on main', icon: 'github' },
  { label: 'Issues', detail: 'In your backlog', icon: 'linear' },
  { label: 'Alerts and questions', detail: 'In Slack', icon: 'slack' },
];
const ends = [10, 30, 50, 70, 90];
---

<figure class="flow" aria-label="How the agent works: sources and context go in, reviewed work comes out">
  <div class="flow-col">
    <span class="label flow-head">Your tools</span>
    <ul class="flow-list">
      {
        sources.map((s) => (
          <li>
            <span class="flow-name">{s.label}</span>
            <span class="flow-icons">{s.icons.map((id) => <Brand id={id} size={18} labelled />)}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <svg class="fan" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    {ends.map((y) => <path d={`M0 ${y} C 55 ${y}, 45 50, 100 50`}></path>)}
  </svg>

  <div class="flow-col flow-core">
    <div class="core-top">
      <div class="ctx">
        <span class="label">Context</span>
        <p>Who it is for, the goal, the business and what is off limits.</p>
        <span class="ctx-from">From the first interview with your engineer</span>
      </div>
      <div class="core-line" aria-hidden="true"></div>
    </div>
    <div class="agent">
      <svg viewBox="0 0 120 120" aria-hidden="true">
        <path class="agent-hex" d={hexPath(60, 60, 92)}></path>
        <path class="agent-hex-in" d={hexPath(60, 60, 58)}></path>
        <path class="agent-hex-core" d={hexPath(60, 60, 24)}></path>
      </svg>
      <strong>Agent Product Engineer</strong>
      <span class="agent-verbs">Reviews · audits · scores · proposes</span>
    </div>
    <div class="core-bottom">
      <div class="core-line" aria-hidden="true"></div>
      <div class="gate"><span class="label">You approve</span> Nothing ships without your yes.</div>
    </div>
  </div>

  <svg class="fan" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    {ends.map((y) => <path d={`M0 50 C 55 50, 45 ${y}, 100 ${y}`}></path>)}
  </svg>

  <div class="flow-col">
    <span class="label flow-head">What you get</span>
    <ul class="flow-list out">
      {
        outputs.map((o) => (
          <li>
            <span class="out-mark">
              {o.icon && <Brand id={o.icon} size={18} />}
              {o.kind === 'score' && (
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path class="mark-hex" d={hexPath(10, 10, 15)}></path></svg>
              )}
              {o.kind === 'doc' && (
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path class="mark-doc" d="M4.5 1.5h8l3 3v14h-11z M7 8h6 M7 11h6 M7 14h4"></path></svg>
              )}
            </span>
            <span>
              <span class="flow-name">{o.label}</span>
              <span class="flow-detail">{o.detail}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</figure>

<style>
  .flow {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(40px, 88px) minmax(0, 0.9fr) minmax(40px, 88px) minmax(0, 1fr);
    align-items: stretch;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    padding: 20px 0 24px;
  }
  .flow-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .flow-head {
    height: 28px;
  }
  .flow-list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: grid;
    grid-template-rows: repeat(5, minmax(56px, 1fr));
  }
  .flow-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border: 1px solid var(--line);
    padding: 8px 12px;
    margin: 4px 0;
    background: var(--bg);
  }
  .flow-list.out li {
    justify-content: flex-start;
  }
  .flow-name {
    font: 600 16px/1.2 var(--cond);
    display: block;
  }
  .flow-detail {
    font: 11.5px/1.4 var(--mono);
    color: var(--muted);
  }
  .flow-icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    color: var(--ink);
  }
  .out-mark {
    width: 34px;
    height: 34px;
    flex: none;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    color: var(--ink);
  }
  .mark-hex {
    fill: var(--accent);
  }
  .mark-doc {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .fan {
    width: 100%;
    height: calc(100% - 28px);
    margin-top: 28px;
    overflow: visible;
  }
  .fan path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  .flow-core {
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    padding-top: 28px;
  }
  .core-top {
    align-self: end;
  }
  .core-bottom {
    align-self: start;
  }
  .gate {
    border: 1px solid var(--accent);
    padding: 8px 12px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .gate .label {
    display: block;
    color: var(--accent-ink);
    margin-bottom: 2px;
  }
  .ctx {
    border: 1px dashed var(--ink);
    padding: 10px 12px;
    background: var(--bg);
  }
  .ctx p {
    margin: 6px 0 4px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .ctx-from {
    font: 11px/1.4 var(--mono);
    color: var(--accent-ink);
  }
  .core-line {
    width: 1px;
    height: 22px;
    margin: 0 auto;
    background: var(--ink);
  }
  .agent {
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--bg);
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 4px;
    padding: 14px 12px 16px;
  }
  .agent svg {
    width: 76px;
    height: 76px;
  }
  .agent-hex {
    fill: none;
    stroke: var(--bg);
    stroke-width: 1.4;
  }
  .agent-hex-in {
    fill: none;
    stroke: var(--bg);
    stroke-width: 1;
    opacity: 0.5;
  }
  .agent-hex-core {
    fill: var(--accent);
  }
  .agent strong {
    font: 600 21px/1.1 var(--cond);
  }
  .agent-verbs {
    font: 11px/1.4 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.75;
  }
  @media (max-width: 900px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .fan {
      display: none;
    }
    .flow-list {
      grid-template-rows: none;
    }
    .flow-core {
      grid-template-rows: none;
      padding: 18px 0;
      position: relative;
    }
    /* a vertical line from the sources, through the agent, to the outputs */
    .flow-core::before,
    .flow-core::after {
      content: '';
      display: block;
      width: 1px;
      height: 18px;
      background: var(--ink);
      margin: -18px auto 0;
    }
    .flow-core::after {
      margin: 0 auto -18px;
    }
  }
</style>
