---
import { STATUS_OPTIONS } from '../atlas/status.ts';

// One status per skill, saved in this browser and, when signed in, to the account.
interface Props {
  id: string;
  name: string;
}
const { id, name } = Astro.props;
const options = STATUS_OPTIONS;
---

<fieldset class="status" data-pagefind-ignore>
  <legend class="label">Your status · {name}</legend>
  <div class="seg" role="radiogroup">
    {
      options.map((o) => (
        <label>
          <input type="radio" name={`status-${id}`} value={o.value} data-status-input={id} checked={o.value === 'none'} />
          <span class={o.cls}>
            <svg viewBox="0 0 22 25" aria-hidden="true"><path d="M11 1.2 20.8 6.8v11.4L11 23.8 1.2 18.2V6.8Z" /></svg>
            {o.label}
          </span>
        </label>
      ))
    }
  </div>
  <p class="note">
    <span class="anon-only">Saved in this browser. <a href="/me/#account">Sign in</a> to keep it on every device.</span>
    <span class="account-only">Saved to your account.</span>
    It colours this skill's tile on <a href="/skills-map/">your map</a>.
  </p>
</fieldset>

<script>
  import type { ProgressStatus } from '../atlas/status.ts';
  import { setStatus } from '../scripts/progress.ts';
  document.querySelectorAll<HTMLInputElement>('input[data-status-input]').forEach((input) => {
    input.addEventListener('change', () => {
      if (!input.checked) return;
      setStatus(input.dataset.statusInput!, input.value as ProgressStatus, 'skill_page');
    });
  });
</script>
