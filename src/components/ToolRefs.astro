---
import type { Tool } from '../atlas/model.ts';
import ToolIcon from './ToolIcon.astro';

interface Props {
  tools: Tool[];
  emptyText?: string;
}
const { tools, emptyText = 'Tools for this topic are being researched.' } = Astro.props;
const PRICING: Record<string, string> = { 'open-source': 'Open source', free: 'Free', freemium: 'Freemium', paid: 'Paid' };
---

{
  tools.length ? (
    <ul class="refs">
      {tools.map((t) => (
        <li class="ref">
          <span class="kind">
            <b>Tool</b>
            {PRICING[t.pricing]}
          </span>
          <div>
            <a class="t tool-ref-title" href={`/tools/${t.id}/`}><ToolIcon url={t.url} size={26} />{t.name}</a>
            <div class="by">
              <a href={t.url} rel="noopener" target="_blank">{new URL(t.url).hostname.replace(/^www\./, '')} ↗</a>
            </div>
            <p class="why">{t.what}</p>
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">{emptyText}</p>
  )
}
<style>.tool-ref-title { display: inline-flex; align-items: center; gap: 10px; }</style>
