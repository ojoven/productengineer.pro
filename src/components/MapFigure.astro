---
// A static, pre-zoomed map. Drawn at build time with no JavaScript; the page script colours
// the tiles from saved progress.
import { mapSvg } from '../lib/atlas.ts';

interface Props {
  focus?: string;
  selected?: string;
  width?: number;
  height?: number;
  scale?: number;
  legend?: boolean;
  explore?: boolean;
  /** Skills to light, in order. Joined by a route when `route` is set. */
  lit?: string[];
  route?: boolean;
}
const { focus = '', selected, width = 640, height = 560, scale, legend = true, explore = true, lit = [], route = false } = Astro.props;
const svg = mapSvg({ focus, width, height, scale, state: { selected: selected ?? null, lit, route: route && lit.length > 1 } });
const href = lit.length ? `/atlas/?lit=${lit.join(',')}` : `/atlas/?at=${encodeURIComponent(selected ?? focus)}`;
---

<figure class="map" data-pagefind-ignore>
  <Fragment set:html={svg} />
  {explore && <a class="open" href={href}>Explore ↗</a>}
  {
    legend && (
      <figcaption class="legend">
        <span><i />Not started</span>
        <span><i class="l" />Learning</span>
        <span><i class="c" />Comfortable</span>
        <span><i class="ni" />Not interested</span>
        {lit.length > 0 && <span><i class="lit" />Used in this work</span>}
      </figcaption>
    )
  }
</figure>
