---
// The facts at the top of an entry, in a fixed order, so a reader can scan any entry the same way:
// research shows the question and method; applied work shows problem, hypothesis, metric and result.
import { DECISION, STATUS, VERDICT, formatDate, products, type Item } from '../lib/editorial.ts';

interface Props {
  entry: Item;
}
const { entry } = Astro.props;
const prods = products();
const notYet = 'Not measured yet';
/** "1:30:46" → "1 h 31 min", "42:10" → "42 min". */
const runtime = (d: string) => {
  const p = d.split(':').map(Number);
  const [h, m, s] = p.length === 3 ? p : [0, p[0], p[1]];
  const total = h * 60 + m + Math.round(s / 60);
  return total >= 60 ? `${Math.floor(total / 60)} h ${total % 60} min` : `${total} min`;
};
---

<dl class="facts">
  {
    'subjects' in entry.data ? (
      <>
        <div>
          <dt>Question</dt>
          <dd>{entry.data.question}</dd>
        </div>
        <div>
          <dt>How I looked</dt>
          <dd>
            <div class="clamp" id="facts-method" data-clamp>{entry.data.method}</div>
            <button type="button" class="read-more" aria-controls="facts-method" aria-expanded="false" hidden>Read more</button>
          </dd>
        </div>
        {entry.data.subjects.length > 0 && (
          <div>
            <dt>{entry.data.subjects.length > 1 ? 'Products' : 'Product'}</dt>
            <dd>
              {entry.data.subjects.map((s, i) => (
                <>
                  {i > 0 && ', '}
                  {s.url ? <a href={s.url} rel="noopener">{s.name}</a> : s.name}
                  {s.maker && s.maker !== s.name && <span class="muted"> by {s.maker}</span>}
                  {s.what && 'subjects' in entry.data && entry.data.subjects.length === 1 && <span class="muted">. {s.what}</span>}
                </>
              ))}
            </dd>
          </div>
        )}
        {entry.data.episode && (
          <div>
            <dt>Episode</dt>
            <dd>
              <a href={entry.data.episode.url} rel="noopener">{entry.data.episode.show}</a>
              <span class="muted">
                {' '}hosted by {entry.data.episode.hostUrl ? <a href={entry.data.episode.hostUrl} rel="noopener">{entry.data.episode.host}</a> : entry.data.episode.host}
                {' '}· {formatDate(entry.data.episode.published)} · {runtime(entry.data.episode.duration)}
                {entry.data.episode.language && <> · in {entry.data.episode.language}</>}
              </span>
            </dd>
          </div>
        )}
        {entry.data.person && (
          <div>
            <dt>{entry.data.kind === 'podcast' ? 'Guest' : 'Interviewed'}</dt>
            <dd>
              {entry.data.person.url ? <a href={entry.data.person.url} rel="noopener">{entry.data.person.name}</a> : entry.data.person.name}
              <span class="muted">, {entry.data.person.role}</span>
            </dd>
          </div>
        )}
      </>
    ) : (
      <>
        <div>
          <dt>Product</dt>
          <dd>
            {(() => {
              const p = prods[entry.data.product];
              if (!p) return entry.data.product;
              return (
                <>
                  {p.url ? <a href={p.url} rel="noopener">{p.name}</a> : p.name}
                  <span class="muted"> · {p.what}</span>
                </>
              );
            })()}
          </dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>
            {STATUS[entry.data.status]} · {formatDate(entry.data.started)}
            {entry.data.ended && entry.data.ended !== entry.data.started && <> to {formatDate(entry.data.ended)}</>}
          </dd>
        </div>
        <div>
          <dt>Problem</dt>
          <dd>{entry.data.problem}</dd>
        </div>
        {entry.data.hypothesis && (
          <div>
            <dt>Hypothesis</dt>
            <dd>{entry.data.hypothesis}</dd>
          </div>
        )}
        {entry.data.metric && (
          <div>
            <dt>Primary metric</dt>
            <dd>
              {entry.data.metric.name}
              <span class="metric">
                <span><b>Baseline</b>{entry.data.metric.baseline ?? '—'}</span>
                <span><b>Target</b>{entry.data.metric.target ?? '—'}</span>
                <span><b>Result</b>{entry.data.metric.result ?? notYet}</span>
              </span>
            </dd>
          </div>
        )}
        {entry.data.guardrails.length > 0 && (
          <div>
            <dt>Guardrails</dt>
            <dd>
              <ul>
                {entry.data.guardrails.map((g) => (
                  <li>
                    {g.name}
                    <span class="muted"> · {g.result ?? notYet}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )}
        {entry.data.kind === 'experiment' && (
          <div>
            <dt>Result</dt>
            <dd>
              {VERDICT[entry.data.verdict]} · {DECISION[entry.data.decision]}
            </dd>
          </div>
        )}
      </>
    )
  }
</dl>

<script>
  // Cut a long fact to three lines with a Read more button. Without JS the full text shows.
  document.querySelectorAll<HTMLElement>('[data-clamp]').forEach((text) => {
    const button = text.parentElement?.querySelector<HTMLButtonElement>('.read-more');
    if (!button) return;
    const measure = () => {
      if (button.getAttribute('aria-expanded') === 'true') return;
      text.classList.add('is-clamped');
      const overflows = text.scrollHeight > text.clientHeight + 1;
      text.classList.toggle('is-clamped', overflows);
      button.hidden = !overflows;
    };
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Show less' : 'Read more';
      text.classList.toggle('is-clamped', !open);
    });
    measure();
    new ResizeObserver(measure).observe(text.parentElement!);
  });
</script>
