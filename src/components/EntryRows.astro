---
// A list of In practice entries: date, title, summary and what kind of work it is.
import Faces from './Faces.astro';
import { KIND, STATUS, VERDICT, entryFaces, itemDate, itemPath, formatDate, products, type Item } from '../lib/editorial.ts';

interface Props {
  items: Item[];
  compact?: boolean;
}
const { items, compact = false } = Astro.props;
const prods = products();
const subject = (e: Item) =>
  'product' in e.data
    ? (prods[e.data.product]?.name ?? e.data.product)
    : e.data.subjects.map((s) => s.name).join(', ') || (e.data.person?.name ?? '');
---

<ul class:list={['index', 'entries', { compact }]}>
  {
    items.map((e) => (
      <li>
        <div class="row entry-row">
          <span class="code">{formatDate(itemDate(e))}</span>
          <a class="name" href={itemPath(e)}><Faces faces={entryFaces(e)} />{e.data.title}</a>
          <span class="go" aria-hidden="true">→</span>
          {!compact && <span class="sub">{e.data.summary}</span>}
          <span class="meta">
            <span class="tag">{KIND[e.data.kind]}</span>
            <span class="count">{subject(e)}</span>
            {'product' in e.data && <span class="count">{STATUS[e.data.status]}</span>}
            {'product' in e.data && e.data.kind === 'experiment' && e.data.verdict !== 'pending' && <span class="count">{VERDICT[e.data.verdict]}</span>}
            <span class="count">{e.data.skills.length} skills</span>
            {e.data.placeholder && <span class="tag is-placeholder">Placeholder</span>}
          </span>
        </div>
      </li>
    ))
  }
</ul>
{items.length === 0 && <p class="empty">Nothing here yet.</p>}
