---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans-condensed/500.css';
import '@fontsource/ibm-plex-sans-condensed/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
// B: Geist, from logo concept 01. Only the family in use is downloaded.
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
// C: Dot, from logo round 1 (concept 08): Schibsted Grotesk titles and wordmark, Literata body.
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';
import '@fontsource/schibsted-grotesk/700.css';
import '@fontsource/schibsted-grotesk/800.css';
import '@fontsource/literata/400.css';
import '@fontsource/literata/500.css';
import '@fontsource/literata/600.css';
import '../styles/site.css';
import { mapCss } from '../atlas/map-css.ts';
import { SITE } from '../site.ts';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Mark the main content for the search index. */
  searchable?: boolean;
  bodyClass?: string;
  image?: string;
}
const { title, description = SITE.description, noindex = false, searchable = true, bodyClass = '', image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · The map of product engineering`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const path = Astro.url.pathname;
const current = (prefix: string) => (path.startsWith(prefix) ? 'page' : undefined);
const ogImage = new URL(image ?? '/og/default.jpg', SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const t = localStorage.getItem('pe-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
      // Logo and type while we choose, remembered in this browser:
      // ?type=plex (A, tile + Plex), ?type=geist (B, tile + Geist), ?type=dot (C, the tile as the dot, Schibsted Grotesk + Literata).
      window.peType = (t) => {
        const root = document.documentElement;
        if (t === 'geist' || t === 'dot') root.dataset.type = t;
        else delete root.dataset.type;
        const icon = document.querySelector('link[rel="icon"]');
        if (icon) icon.href = t === 'dot' ? '/favicon-dot.svg' : '/favicon.svg';
      };
      try {
        const q = new URLSearchParams(location.search).get('type');
        if (q === 'plex' || q === 'geist' || q === 'dot') localStorage.setItem('pe-type', q);
        window.peType(localStorage.getItem('pe-type'));
      } catch {}
      if (/(?:^|;\s*)pe_auth=1(?:;|$)/.test(document.cookie)) document.documentElement.classList.add('signed-in');
    </script>
    <style is:inline set:html={mapCss()}></style>
    <Analytics />
    <script is:inline src="https://analytics.mtorr.es/api/script.js?siteId=0b9e1ee60f53" defer></script>
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="ProductEngineer.pro, home">
          <svg class="brand-tile" viewBox="0 0 17.32 20" aria-hidden="true"><path d="M8.66 0 17.32 5v10L8.66 20 0 15V5Z" fill="currentColor"></path></svg>
          <span class="wordmark">productengineer<svg class="brand-dot" viewBox="0 0 17.32 20" aria-hidden="true"><path d="M8.66 0 17.32 5v10L8.66 20 0 15V5Z" fill="currentColor"></path></svg><span class="tld"><span class="tld-period">.</span>pro</span></span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/atlas/" aria-current={current('/atlas')}>Atlas</a>
          <a href="/skills/" aria-current={current('/skills')}>Skills</a>
          <a class="opt" href="/tools/" aria-current={current('/tools')}>Tools</a>
          <a class="opt" href="/resources/" aria-current={current('/resources')}>Resources</a>
          <a href="/me/" aria-current={current('/me')}><span class="anon-only">Sign in</span><span class="account-only">Account</span></a>
          <a href="/search/" aria-label="Search" aria-current={current('/search')}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          </a>
          <button type="button" id="theme-toggle" aria-label="Switch light or dark theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>ProductEngineer.pro · a map of product engineering · <span class="anon-only">progress stays in this browser</span><span class="account-only">progress saved to your account</span></span>
        <span><a href="/about/">About</a> · <a href="/skills/">Agent skills</a> · <a href="/tools/">Tools</a> · <a href="/resources/">Resources</a> · <a href="/search/">Search</a></span>
      </div>
    </footer>
    {
      import.meta.env.DEV && (
        <div class="type-switch" role="group" aria-label="Logo and font set">
          <button type="button" data-type-set="plex">A · Plex</button>
          <button type="button" data-type-set="geist">B · Geist</button>
          <button type="button" data-type-set="dot">C · Dot</button>
        </div>
      )
    }
    <script>
      import { applyProgress, onChange, cycleStatus } from '../scripts/progress.ts';
      import { startSync } from '../scripts/sync.ts';
      import { linkHover } from '../scripts/hover.ts';
      import { track } from '../scripts/track.ts';
      applyProgress();
      onChange(() => applyProgress());
      startSync();
      linkHover();

      // the hexagon status control in every list: not started -> learning -> comfortable -> not interested
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-cycle]');
        if (!btn) return;
        e.preventDefault();
        const next = cycleStatus(btn.dataset.cycle!);
        track('Status set', { status: next, from: 'list' });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-type-set]').forEach((b) =>
        b.addEventListener('click', () => {
          const t = b.dataset.typeSet!;
          (window as unknown as { peType: (t: string) => void }).peType(t);
          try {
            localStorage.setItem('pe-type', t);
          } catch {}
        }),
      );

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('pe-theme', root.dataset.theme);
        } catch {}
      });
    </script>
  </body>
</html>
